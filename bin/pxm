#!/usr/bin/python3
"""pxm: local PHP development for Omarchy, in the spirit of Laravel Herd.

Setup
  pxm setup                         one-time setup (asks for your password once)
      [--sites-dir DIR] [--services "mysql mailpit"|all|none] [--yes]   answer setup's questions up front
  pxm doctor                        check that everything is in place
  pxm uninstall [--purge]           undo setup (--purge also deletes PHP versions and settings)

PHP versions
  pxm php list                      installed versions (* = global)
  pxm php available                 versions you can install
  pxm php install <8.4|8.4.23>      download a version (quick: prebuilt, no intl/sodium)
  pxm php build <8.4|8.6.0RC3>      compile a version with ALL extensions (intl, sodium…),
                                    incl. alphas/betas/RCs; runs in the background (~2-5 min)
  pxm php prereleases               PHP alphas/betas/RCs you can build
  pxm php use <8.4|system>          set the global version
  pxm php isolate <8.4|system>      pin the current project (writes .php-version)
  pxm php unisolate                 remove the pin
  pxm php uninstall <8.4.23>        remove a version
  pxm php which                     which PHP runs in this folder
  pxm php info                      versions, extensions and php.ini paths

Node versions (uses mise, which Omarchy already ships; pxm just drives it)
  pxm node list                     installed versions (* = global)
  pxm node available                Node lines you can install (LTS marked)
  pxm node install <24|lts|24.11.0>
  pxm node use <24|lts|latest>      set the global version
  pxm node isolate <22> [path]      pin a project (writes .nvmrc)
  pxm node unisolate [path]         remove the pin
  pxm node uninstall <24.11.0>
  pxm node which [path]             which Node runs in this folder
  pxm node nvmrc on|off             follow .nvmrc / .node-version files (on by default)

Sites (every folder in your sites folder becomes https://<folder>.test)
  pxm sites                         list sites
  pxm link [name]                   serve the current folder as https://<name>.test
  pxm unlink <name>                 stop serving a linked folder
  pxm secure <name>                 HTTPS on (the default)
  pxm unsecure <name>               plain http
  pxm open [name|url]               open a site (or any URL) in your browser
  pxm apply                         regenerate the web server config (runs automatically)
  pxm trust                         trust pxm's local HTTPS certificate again

Sharing (Cloudflare Tunnel)
  pxm share [name] [--quick]        give a site a public https link: <name>.<your domain> once a domain
                                    is connected, otherwise a random *.trycloudflare.com link
  pxm share domain <example.com>    connect your own Cloudflare domain (one-time browser login)
  pxm share domain off              go back to random links
  pxm unshare [name]                stop sharing (the link stops working at once)
  pxm shares                        what's being shared right now

Services (Docker containers: picked during setup, or downloaded the first time you start them)
  pxm service list                  dev services and whether they run
  pxm service start <name>          web, mysql, postgres, redis, mailpit
  pxm service stop <name>           stays stopped after a reboot

Apps (which editor / terminal / file manager / browser pxm opens)
  pxm prefs                         show your choices and what's installed
  pxm prefs set editor zed          pick one: editor, terminal, files, browser
  pxm prefs set editor system       back to Omarchy's default
  pxm prefs set editor custom 'phpstorm {path}'   any command ({path} = folder/file)
  pxm edit [path]                   open a folder or file in your editor
  pxm term [path] [-- command]      open a terminal there
  pxm files [path]                  open a folder in your file manager

Other
  pxm ui [section]                  open the pxm window (sites, php, node, services, mail, logs, settings)
  pxm logs [site]                   recent PHP / Laravel errors for a site
  pxm mail test [to]                send a test email to Mailpit
  pxm status --json                 everything, for the bar panel and window
  pxm --version
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from pathlib import Path

HOME = Path.home()
DATA = HOME / '.local/share/pxm'
PHPS = DATA / 'php'
SHIMS = DATA / 'bin'
LOGS = DATA / 'log'
CONF_DIR = HOME / '.config/pxm'
CONF = CONF_DIR / 'config.json'
GLOBAL_FILE = CONF_DIR / 'global'          # read by the shell shim (fast, no JSON)
SYSTEM_PHP = '/usr/bin/php'                # Arch's php package ("system" in pxm), if installed
BUILDS = 'https://dl.static-php.dev/static-php-cli/common/'
CACHE = HOME / '.cache/pxm'
SELF = Path(__file__).resolve()            # bin/pxm inside the Omarchy plugin folder
PLUGIN_DIR = SELF.parent.parent
PLUGIN_ID = 'pxm'
LINK = HOME / '.local/bin/pxm'             # `pxm` on PATH (created by pxm setup)
SERVICES = [  # id, name, port, url to open (or None), how it runs
    ('web', 'Web server (Caddy)', 443, None, 'systemd:pxm-caddy.service'),
    ('mysql', 'MySQL', 3306, None, 'docker:mysql8'),
    ('postgres', 'PostgreSQL', 5432, None, 'docker:postgres18'),
    ('redis', 'Redis', 6379, None, 'docker:redis'),
    ('mailpit', 'Mailpit', 8025, 'http://localhost:8025', 'docker:mailpit'),
]
# How each container is created the first time it's started. Same names and settings as Omarchy's
# Install > Development > Docker DB menu, so containers made there are picked up too.
DOCKER_RUN = {
    'mysql8': ['-p', '127.0.0.1:3306:3306', '-e', 'MYSQL_ROOT_PASSWORD=', '-e', 'MYSQL_ALLOW_EMPTY_PASSWORD=true',
               'mysql:8.4'],
    'postgres18': ['-p', '127.0.0.1:5432:5432', '-e', 'POSTGRES_HOST_AUTH_METHOD=trust', 'postgres:18'],
    'redis': ['-p', '127.0.0.1:6379:6379', 'redis:7'],
    'mailpit': ['-p', '127.0.0.1:1025:1025', '-p', '127.0.0.1:8025:8025', 'axllent/mailpit'],
}

DEFAULT_CONFIG = {'sites_dir': '', 'links': {}, 'insecure': []}
CADDYFILE = CONF_DIR / 'Caddyfile'
CA_ROOT = HOME / '.local/share/caddy/pki/authorities/local/root.crt'
CA_NAME = 'pxm local CA'
CA_ANCHOR = '/etc/ca-certificates/trust-source/anchors/pxm-local-ca.crt'
NSSDB = HOME / '.pki/nssdb'


def version():
    try:
        return json.loads((PLUGIN_DIR / 'manifest.json').read_text()).get('version', '?')
    except (OSError, ValueError):
        return '?'


def local_timezone():
    """'Europe/Berlin' etc. from /etc/localtime, for php.ini's date.timezone."""
    target = os.path.realpath('/etc/localtime')
    return target.split('/zoneinfo/', 1)[1] if '/zoneinfo/' in target else 'UTC'


def has_system_php():
    return Path(SYSTEM_PHP).exists() and Path('/usr/bin/php-fpm').exists()


# ------------------------------------------------------------------ config
def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if CONF.exists():
        cfg.update(json.loads(CONF.read_text()))
    return cfg


def save_config(cfg):
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONF.with_suffix('.tmp')
    tmp.write_text(json.dumps(cfg, indent=2))
    tmp.rename(CONF)


def global_version():
    try:
        return GLOBAL_FILE.read_text().strip() or 'system'
    except OSError:
        return 'system'


def die(msg):
    print(f'pxm: {msg}', file=sys.stderr)
    sys.exit(1)


# ------------------------------------------------------------------ versions
def vkey(v):
    """8.6.0alpha1 < 8.6.0beta2 < 8.6.0RC3 < 8.6.0 < 8.6.1"""
    m = re.match(r'(\d+)\.(\d+)(?:\.(\d+))?(?:(alpha|beta|RC)(\d+))?', v, re.I)
    if not m:
        return (0,)
    stage = {'alpha': 0, 'beta': 1, 'rc': 2}.get((m.group(4) or '').lower(), 3)
    return (int(m.group(1)), int(m.group(2)), int(m.group(3) or 0), stage, int(m.group(5) or 0))


def installed():
    """{full_version: path} for installed static builds."""
    out = {}
    if PHPS.exists():
        for d in PHPS.iterdir():
            if d.is_dir() and not d.is_symlink() and d.name != 'system' and (d / 'bin/php').exists():
                out[d.name] = d
    return dict(sorted(out.items(), key=lambda kv: vkey(kv[0])))


def minor(v):
    return '.'.join(v.split('.')[:2])


def refresh_minor_links():
    """php/8.4 -> php/8.4.23 (highest installed patch); the shim and FPM use these.
    If a minor now points at a different build, restart its PHP-FPM so sites use it."""
    before = {l.name: os.readlink(l) for l in PHPS.iterdir() if l.is_symlink()} if PHPS.exists() else {}
    best = _relink()
    for m, full in best.items():
        if before.get(m) not in (None, full):
            subprocess.run(['systemctl', '--user', 'try-restart', f'pxm-fpm@{m}.service'], capture_output=True)
    return best


def _relink():
    best = {}
    for full in installed():
        m = minor(full)
        if m not in best or vkey(full) > vkey(best[m]):
            best[m] = full
    for link in PHPS.iterdir() if PHPS.exists() else []:
        if link.is_symlink():
            link.unlink()
    for m, full in best.items():
        (PHPS / m).symlink_to(full)
    return best


def resolve(spec):
    """'8.4' or '8.4.23' or 'system' -> canonical name stored in config ('8.4' / 'system')."""
    if spec in ('system', 'sys'):
        if not has_system_php():
            die("Arch's PHP is not installed (sudo pacman -S php php-fpm)")
        return 'system'
    m = minor(spec)
    if not (PHPS / m).exists():
        die(f'PHP {spec} is not installed. Run: pxm php install {spec}')
    return m


def php_binary(name):
    return SYSTEM_PHP if name == 'system' else str(PHPS / name / 'bin/php')


def project_version(start=None):
    d = Path(start or os.getcwd()).resolve()
    for p in [d, *d.parents]:
        f = p / '.php-version'
        if f.is_file():
            return f.read_text().strip(), p
    return None, None


def full_version(name):
    if name == 'system':
        if not Path(SYSTEM_PHP).exists():
            return ''
        r = subprocess.run([SYSTEM_PHP, '-r', 'echo PHP_VERSION;'], capture_output=True, text=True)
        return r.stdout.strip() or '?'
    target = PHPS / name
    return os.path.basename(os.readlink(target)) if target.is_symlink() else name


# ------------------------------------------------------------------ remote
UA = {'User-Agent': 'pxm/1.0 (curl-compatible; +https://github.com/crazywhalecc/static-php-cli)'}


def fetch(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=30) as r:
        return r.read().decode()


def download(url, dest):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=300) as r, open(dest, 'wb') as f:
        shutil.copyfileobj(r, f)


def available(max_age=6 * 3600):
    """Latest prebuilt patch for each minor line: {'8.4': '8.4.23', ...} (cached for 6 h)."""
    import time
    cache = CACHE / 'available.json'
    if max_age and cache.exists() and time.time() - cache.stat().st_mtime < max_age:
        return json.loads(cache.read_text())
    try:
        listing = fetch(BUILDS)
    except Exception:
        return json.loads(cache.read_text()) if cache.exists() else {}
    found = {}
    for v in set(re.findall(r'php-(\d+\.\d+\.\d+)-fpm-linux-x86_64\.tar\.gz', listing)):
        m = minor(v)
        if m not in found or vkey(v) > vkey(found[m]):
            found[m] = v
    found = dict(sorted(found.items(), key=lambda kv: vkey(kv[0])))
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / 'available.json').write_text(json.dumps(found))
    return found


# ------------------------------------------------------------------ install
PHP_INI = """; pxm defaults for local development (edit freely)
memory_limit = 512M
upload_max_filesize = 100M
post_max_size = 100M
max_execution_time = 120
display_errors = On
display_startup_errors = On
error_reporting = E_ALL
date.timezone = {tz}
opcache.enable = 1
opcache.enable_cli = 0
opcache.validate_timestamps = 1
opcache.revalidate_freq = 0
"""

FPM_CONF = """; pxm FPM pool for PHP {minor}
[global]
error_log = {logs}/php-{minor}-fpm.log
daemonize = no

[pxm]
listen = {runtime}/php-fpm.sock
listen.mode = 0660
pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 30s
catch_workers_output = yes
decorate_workers_output = no
clear_env = no
php_admin_value[error_log] = {logs}/php-{minor}.log
"""


def write_version_config(d, full):
    m = minor(full)
    etc = d / 'etc'
    (etc / 'conf.d').mkdir(parents=True, exist_ok=True)
    ini = etc / 'php.ini'
    if not ini.exists():
        ini.write_text(PHP_INI.format(tz=local_timezone()))
    runtime = f"/run/user/{os.getuid()}/pxm-fpm-{m}"
    (etc / 'php-fpm.conf').write_text(FPM_CONF.format(minor=m, logs=LOGS, runtime=runtime))


def install(spec):
    CACHE.mkdir(parents=True, exist_ok=True)
    marker = CACHE / f'installing-{spec}'
    marker.touch()
    try:
        _install(spec)
    finally:
        marker.unlink(missing_ok=True)


def _install(spec):
    avail = available(max_age=0)
    full = spec if spec.count('.') == 2 else avail.get(spec)
    if not full or minor(full) not in avail:
        die(f"no prebuilt PHP {spec}. Available: {', '.join(avail.values())}")
    dest = PHPS / full
    if (dest / 'bin/php').exists():
        print(f'PHP {full} is already installed.')
    else:
        print(f'Downloading PHP {full} (CLI + FPM, about 60 MB)…', flush=True)
        tmp = Path(tempfile.mkdtemp(prefix='pxm-'))
        try:
            (tmp / 'bin').mkdir()
            for kind in ('cli', 'fpm'):
                url = f'{BUILDS}php-{full}-{kind}-linux-x86_64.tar.gz'
                tgz = tmp / f'{kind}.tgz'
                download(url, tgz)
                with tarfile.open(tgz) as t:
                    for m in t.getmembers():
                        if m.isfile() and os.path.basename(m.name) in ('php', 'php-fpm'):
                            m.name = os.path.basename(m.name)
                            t.extract(m, tmp / 'bin', filter='data')
            for b in ('php', 'php-fpm'):
                os.chmod(tmp / 'bin' / b, 0o755)
            PHPS.mkdir(parents=True, exist_ok=True)
            shutil.move(str(tmp), dest)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        write_version_config(dest, full)
        print(f'Installed PHP {full}.')
    refresh_minor_links()
    write_shim()
    if global_version() == 'system' and not GLOBAL_FILE.exists():
        use(minor(full))


def uninstall(spec):
    targets = [v for v in installed() if v == spec or minor(v) == spec]
    if not targets:
        die(f'PHP {spec} is not installed.')
    for v in targets:
        shutil.rmtree(PHPS / v)
        print(f'Removed PHP {v}.')
    best = refresh_minor_links()
    if global_version() != 'system' and not (PHPS / global_version()).exists():
        fallback = 'system' if has_system_php() else (max(best, key=vkey) if best else None)
        if fallback:
            use(fallback)
        else:
            GLOBAL_FILE.unlink(missing_ok=True)
            print('No PHP left. Install one: pxm php install 8.5')


def use(spec):
    name = resolve(spec)
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    GLOBAL_FILE.write_text(name + '\n')
    write_shim()
    print(f'Global PHP: {name} ({full_version(name)})')
    if CADDYFILE.exists():
        apply(quiet=True)


def isolate(spec, path=None):
    name = resolve(spec)
    root = Path(path or os.getcwd()).resolve()
    (root / '.php-version').write_text(name + '\n')
    print(f'{root.name} now uses PHP {name} ({full_version(name)})')
    if CADDYFILE.exists():
        apply(quiet=True)


def unisolate(path=None):
    _, root = project_version(path)
    if not root:
        die('this folder has no .php-version')
    (root / '.php-version').unlink()
    print(f'{root.name} now follows the global PHP ({global_version()})')
    if CADDYFILE.exists():
        apply(quiet=True)



# ------------------------------------------------------------------ full builds (static-php-cli)
SPC = DATA / 'spc/spc'
SPC_WORK = DATA / 'spc/work'
FULL_EXTENSIONS = ('bcmath,bz2,calendar,ctype,curl,dom,exif,fileinfo,filter,ftp,gd,gmp,iconv,intl,mbstring,'
                   'mysqli,mysqlnd,opcache,openssl,pcntl,pdo,pdo_mysql,pdo_pgsql,pdo_sqlite,pgsql,phar,posix,'
                   'readline,redis,session,simplexml,sockets,sodium,sqlite3,tokenizer,xml,xmlreader,xmlwriter,'
                   'xsl,zip,zlib')
BUILDABLE_MINORS = ['8.1', '8.2', '8.3', '8.4', '8.5']
PRERELEASES_URL = 'https://www.php.net/pre-release-builds.php?format=json'


def prereleases(max_age=3 * 3600):
    """Active PHP alphas/betas/RCs from php.net: [{'version': '8.6.0RC3', 'url': ..., 'date': ...}]"""
    import time
    cache = CACHE / 'prereleases.json'
    if max_age and cache.exists() and time.time() - cache.stat().st_mtime < max_age:
        return json.loads(cache.read_text())
    try:
        data = json.loads(fetch(PRERELEASES_URL))
    except Exception:
        return json.loads(cache.read_text()) if cache.exists() else []
    out = []
    for entry in data.values():
        if not isinstance(entry, dict):
            continue
        r = entry.get('release') or {}
        files = r.get('files') or {}
        url = (files.get('xz') or files.get('gz') or {}).get('path')
        if entry.get('active') and r.get('version') and url:
            out.append({'version': r['version'], 'url': url, 'date': r.get('date', ''),
                        'sha256': (files.get('xz') or files.get('gz') or {}).get('sha256', '')})
    out.sort(key=lambda x: vkey(x['version']), reverse=True)
    CACHE.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(out))
    return out


def building():
    """{spec: last status line} for builds in progress."""
    out = {}
    if CACHE.exists():
        for f in CACHE.glob('building-*'):
            out[f.name.removeprefix('building-')] = f.read_text().strip()
    return out


def build(spec, foreground=False):
    """Compile PHP `spec` (a minor like 8.4 = latest stable, or an exact version / pre-release)."""
    if not foreground:
        # run detached so it survives closing the terminal or the panel
        unit = 'pxm-build-' + re.sub(r'[^A-Za-z0-9]', '-', spec)
        log = LOGS / f'build-{spec}.log'
        LOGS.mkdir(parents=True, exist_ok=True)
        r = subprocess.run(['systemd-run', '--user', '--collect', '--quiet', f'--unit={unit}',
                            '--property=Nice=10', f'--property=StandardOutput=file:{log}',
                            f'--property=StandardError=file:{log}',
                            str(Path(__file__).resolve()), 'php', 'build', spec, '--foreground'],
                           capture_output=True, text=True)
        if r.returncode:
            die(r.stderr.strip() or 'could not start the build')
        print(f'Building PHP {spec} in the background (log: {log}).')
        print('You will get a notification when it is done (about 5 minutes the first time, ~2 minutes after that).')
        return

    import fcntl
    CACHE.mkdir(parents=True, exist_ok=True)
    lock = open(CACHE / 'build.lock', 'w')
    marker = CACHE / f'building-{spec}'
    marker.write_text('Waiting for another build to finish…')
    fcntl.flock(lock, fcntl.LOCK_EX)
    env = dict(os.environ, SPC_LIBC='glibc')
    SPC_WORK.mkdir(parents=True, exist_ok=True)

    def step(msg):
        marker.write_text(msg)
        print(f'== {msg}', flush=True)

    def run(args):
        p = subprocess.Popen([str(SPC), *args], cwd=SPC_WORK, env=env, stdout=subprocess.PIPE,
                             stderr=subprocess.STDOUT, text=True)
        for line in p.stdout:
            line = re.sub(r'\x1b\[[0-9;]*m', '', line).rstrip()
            print(line, flush=True)
            m = re.search(r'\[I\] (Building|Downloading|Compiling|Patching|Extracting)[^\[]*', line)
            if m:
                marker.write_text(m.group(0).removeprefix('[I] ').strip()[:80])
        if p.wait():
            raise RuntimeError(f'spc {args[0]} failed (see log)')

    try:
        if not SPC.exists():
            step('Downloading the build tool…')
            SPC.parent.mkdir(parents=True, exist_ok=True)
            download('https://dl.static-php.dev/static-php-cli/spc-bin/nightly/spc-linux-x86_64', SPC)
            SPC.chmod(0o755)
        if not (SPC_WORK / 'pkgroot').exists():
            step('Preparing the build tool…')
            run(['doctor', '--auto-fix'])
        step('Downloading PHP source…')
        dl = ['download', f'--for-extensions={FULL_EXTENSIONS}', '--ignore-cache-sources=php-src']
        if re.fullmatch(r'\d+\.\d+', spec):
            dl.append(f'--with-php={spec}')
        else:
            pre = {p['version']: p['url'] for p in prereleases(max_age=0)}
            url = pre.get(spec) or f'https://www.php.net/distributions/php-{spec}.tar.xz'
            dl += [f'--with-php={minor(spec)}', f'--custom-url=php-src:{url}']
        run(dl)
        step('Compiling PHP (this is the long part)…')
        run(['build', FULL_EXTENSIONS, '--build-cli', '--build-fpm'])
        built = SPC_WORK / 'buildroot/bin'
        version = subprocess.run([str(built / 'php'), '-r', 'echo PHP_VERSION;'],
                                 capture_output=True, text=True).stdout.strip()
        if not version:
            raise RuntimeError('the build produced no working php binary')
        step(f'Installing PHP {version}…')
        dest = PHPS / version
        if dest.exists():
            shutil.rmtree(dest)
        (dest / 'bin').mkdir(parents=True)
        for b in ('php', 'php-fpm'):
            shutil.copy2(built / b, dest / 'bin' / b)
        write_version_config(dest, version)
        (dest / 'pxm.json').write_text(json.dumps({'kind': 'full', 'extensions': FULL_EXTENSIONS}))
        refresh_minor_links()
        write_shim()
        if CADDYFILE.exists():
            apply(quiet=True)
        notify_user(f'PHP {version} is ready', 'Full build with intl, sodium and more. Switch to it in pxm.')
        print(f'Installed PHP {version} (full build).')
    except Exception as e:
        notify_user(f'Building PHP {spec} failed', f'{e}. Log: {LOGS}/build-{spec}.log')
        raise
    finally:
        marker.unlink(missing_ok=True)
        lock.close()


def notify_user(title, body=''):
    subprocess.run(['omarchy-notification-send', '-g', '\U000F031F', title, body], capture_output=True)


def build_kind(full):
    meta = PHPS / full / 'pxm.json'
    try:
        return json.loads(meta.read_text()).get('kind', 'prebuilt')
    except OSError:
        return 'prebuilt'

# ------------------------------------------------------------------ shim
SHIM = r'''#!/bin/bash
# pxm PHP shim: picks the project's PHP (.php-version) or the global one (pxm php use).
v=
d=$PWD
while [ -n "$d" ]; do
  if [ -f "$d/.php-version" ]; then read -r v < "$d/.php-version"; break; fi
  d=${d%/*}
done
[ -z "$v" ] && read -r v < "$HOME/.config/pxm/global" 2>/dev/null
if [ -z "$v" ] || [ "$v" = system ] || [ ! -x "$HOME/.local/share/pxm/php/$v/bin/php" ]; then
  [ -x /usr/bin/php ] && exec /usr/bin/php "$@"
  echo "php: no PHP version is set up yet. Run: pxm php install 8.5" >&2
  exit 127
fi
p=$HOME/.local/share/pxm/php/$v
PHPRC=$p/etc PHP_INI_SCAN_DIR=$p/etc/conf.d exec "$p/bin/php" "$@"
'''


def write_shim():
    SHIMS.mkdir(parents=True, exist_ok=True)
    shim = SHIMS / 'php'
    if not shim.exists() or shim.read_text() != SHIM:
        shim.write_text(SHIM)
        shim.chmod(0o755)



# ------------------------------------------------------------------ sites
def ensure_system_dir():
    """php/system: lets sites run on Arch's PHP (with Xdebug) through the same FPM template."""
    if not has_system_php():
        return
    d = PHPS / 'system'
    (d / 'bin').mkdir(parents=True, exist_ok=True)
    (d / 'etc').mkdir(parents=True, exist_ok=True)
    for link, target in ((d / 'bin/php', '/usr/bin/php'), (d / 'bin/php-fpm', '/usr/bin/php-fpm'),
                         (d / 'etc/php.ini', '/etc/php/php.ini'), (d / 'etc/conf.d', '/etc/php/conf.d')):
        if not link.is_symlink():
            if link.exists():
                link.unlink()
            link.symlink_to(target)
    runtime = f"/run/user/{os.getuid()}/pxm-fpm-system"
    (d / 'etc/php-fpm.conf').write_text(FPM_CONF.format(minor='system', logs=LOGS, runtime=runtime))


def slug(name):
    return re.sub(r'[^a-z0-9-]+', '-', name.lower()).strip('-') or 'site'


def sites(cfg=None):
    cfg = cfg or load_config()
    found = {}
    sd = Path(cfg['sites_dir']).expanduser() if cfg.get('sites_dir') else None
    if sd and sd.is_dir():
        for d in sorted(sd.iterdir()):
            if d.is_dir() and not d.name.startswith('.'):
                found[slug(d.name)] = {'path': str(d), 'source': 'parked'}
    for name, path in cfg['links'].items():
        found[name] = {'path': path, 'source': 'linked'}
    g = global_version()
    for name, s in found.items():
        path = Path(s['path'])
        pinned, root = project_version(path)
        s['php'] = pinned if pinned and root and str(path).startswith(str(root)) else g
        if s['php'] != 'system' and not (PHPS / s['php']).exists():
            s['php'] = g
        s['php_pinned'] = bool(pinned)
        s['secure'] = name not in cfg['insecure']
        s['url'] = f"{'https' if s['secure'] else 'http'}://{name}.test"
        s['docroot'] = str(path / 'public') if (path / 'public/index.php').exists() else str(path)
        s['laravel'] = (path / 'artisan').exists()
        s['exists'] = path.is_dir()
    return dict(sorted(found.items()))


def fpm_socket(version):
    return f"/run/user/{os.getuid()}/pxm-fpm-{version}/php-fpm.sock"


def caddyfile(all_sites):
    out = ['# GENERATED by pxm. Do not edit: run `pxm apply` (it runs automatically).',
           '{', '\tadmin localhost:2019', '\tlocal_certs', '\tskip_install_trust', '}', '']
    for name, s in all_sites.items():
        if not s['exists']:
            continue
        host = f"{name}.test" if s['secure'] else f"http://{name}.test"
        out += [f'{host} {{',
                f'\troot * "{s["docroot"]}"',
                '\tencode zstd gzip',
                f'\tphp_fastcgi unix/{fpm_socket(s["php"])}',
                '\tfile_server',
                '}', '']
    # shared sites: a private entrance on 127.0.0.1 for cloudflared. Any Host header is accepted (the visitor's
    # *.trycloudflare.com), and PHP is told the request is https so Laravel builds https links.
    cfg = load_config()
    for name in cfg.get('shared', []):
        s = all_sites.get(name)
        port = cfg.get('share_ports', {}).get(name)
        if not s or not s['exists'] or not port:
            continue
        out += [f'http://:{port} {{',
                '\tbind 127.0.0.1',
                f'\troot * "{s["docroot"]}"',
                '\tencode zstd gzip',
                f'\tphp_fastcgi unix/{fpm_socket(s["php"])} {{',
                '\t\tenv HTTPS on',
                '\t\tenv SERVER_PORT 443',
                '\t}',
                '\tfile_server',
                '}', '']
    return '\n'.join(out)


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], capture_output=True, text=True)


def apply(quiet=False):
    cfg = load_config()
    ensure_system_dir()
    all_sites = sites(cfg)
    text = caddyfile(all_sites)
    changed = not CADDYFILE.exists() or CADDYFILE.read_text() != text
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    CADDYFILE.write_text(text)

    wanted = {s['php'] for s in all_sites.values() if s['exists']}
    running = set()
    r = systemctl('list-units', '--plain', '--no-legend', 'pxm-fpm@*')
    for line in r.stdout.splitlines():
        m = re.match(r'pxm-fpm@(.+)\.service\s+\S+\s+active', line)
        if m:
            running.add(m.group(1))
    # start at login only the PHP-FPM versions that sites use
    for v in sorted(wanted - running):
        systemctl('enable', '--now', f'pxm-fpm@{v}.service')
    for v in sorted(running - wanted):
        systemctl('disable', '--now', f'pxm-fpm@{v}.service')
    for v in sorted(wanted & running):
        systemctl('enable', f'pxm-fpm@{v}.service')

    if cfg.get('web_stopped'):
        pass                       # user turned the web server off (pxm service start web)
    elif systemctl('is-active', 'pxm-caddy.service').stdout.strip() != 'active':
        systemctl('enable', '--now', 'pxm-caddy.service')
        systemctl('enable', '--now', 'pxm-sites.path')
    elif changed:
        systemctl('reload', 'pxm-caddy.service')
    # A brand-new folder (e.g. `laravel new` still running) has no index file yet: look again shortly,
    # for up to 10 minutes after the folder last changed.
    import time
    pending = [s for s in all_sites.values() if s['exists'] and not any(
        (Path(s['docroot']) / f).exists() for f in ('index.php', 'index.html'))
        and time.time() - Path(s['path']).stat().st_mtime < 600]
    if pending:
        subprocess.run(['systemd-run', '--user', '--quiet', '--collect', '--unit=pxm-recheck', '--on-active=20',
                        str(Path(__file__).resolve()), 'apply', '--quiet'], capture_output=True)
    if not quiet:
        served = sum(1 for s in all_sites.values() if s['exists'])
        print(f"{served} site(s) served · PHP-FPM running: {', '.join(sorted(wanted)) or 'none'}")


def find_site(name=None):
    all_sites = sites()
    if name:
        name = slug(name.removesuffix('.test'))
        if name not in all_sites:
            die(f'no site called {name}.test (see: pxm sites)')
        return name, all_sites[name]
    cwd = Path.cwd().resolve()
    for n, s in all_sites.items():
        if cwd == Path(s['path']).resolve() or Path(s['path']).resolve() in cwd.parents:
            return n, s
    die('this folder is not a site; pass a name, or run `pxm link` here')


def link(name=None, path=None):
    cfg = load_config()
    path = str(Path(path or os.getcwd()).resolve())
    name = slug(name or Path(path).name)
    cfg['links'][name] = path
    save_config(cfg)
    apply(quiet=True)
    print(f'Linked {path} → https://{name}.test')


def unlink(name):
    cfg = load_config()
    name = slug(name.removesuffix('.test'))
    if name not in cfg['links']:
        die(f'{name}.test is not a linked site (parked sites go away when you move the folder out of the sites folder)')
    del cfg['links'][name]
    save_config(cfg)
    apply(quiet=True)
    print(f'Unlinked {name}.test')


def set_secure(name, on):
    name, _ = find_site(name)
    cfg = load_config()
    if on and name in cfg['insecure']:
        cfg['insecure'].remove(name)
    if not on and name not in cfg['insecure']:
        cfg['insecure'].append(name)
    save_config(cfg)
    apply(quiet=True)
    print(f"{name}.test now uses {'https' if on else 'http'}")


def trust_nss():
    """Chromium (and other NSS apps) read the user's own certificate database."""
    if not shutil.which('certutil') or not CA_ROOT.exists():
        return False
    NSSDB.mkdir(parents=True, exist_ok=True)
    if not (NSSDB / 'cert9.db').exists():
        subprocess.run(['certutil', '-N', '--empty-password', '-d', f'sql:{NSSDB}'], check=True)
    subprocess.run(['certutil', '-D', '-d', f'sql:{NSSDB}', '-n', CA_NAME], capture_output=True)
    return subprocess.run(['certutil', '-A', '-d', f'sql:{NSSDB}', '-t', 'C,,', '-n', CA_NAME, '-i', str(CA_ROOT)],
                          capture_output=True).returncode == 0


def trust():
    if not CA_ROOT.exists():
        die('the local certificate authority does not exist yet: run pxm setup')
    trust_nss()
    # everything else (curl, PHP, Node, Firefox on Arch) uses the system trust store: needs admin
    r = subprocess.run(['pkexec', 'sh', '-c', f'install -m 644 {shlex.quote(str(CA_ROOT))} {CA_ANCHOR} && trust extract-compat'])
    if r.returncode:
        die('could not add the certificate to the system trust store')
    print('Trusted the pxm HTTPS certificate. Restart your browser if it was open.')


def port_open(port):
    import socket
    with socket.socket() as s:
        s.settimeout(0.3)
        return s.connect_ex(('127.0.0.1', port)) == 0



# ------------------------------------------------------------------ services
SERVICE_INFO = {
    'web': {'details': [['Sites folder', '(set by pxm setup)'], ['Address', 'https://<folder>.test'],
                        ['Certificate', '~/.local/share/caddy/pki/authorities/local/root.crt']],
            'env': 'APP_URL=https://<your-site>.test'},
    'mysql': {'details': [['Host', '127.0.0.1'], ['Port', '3306'], ['User', 'root'], ['Password', '(empty)']],
              'env': 'DB_CONNECTION=mysql\nDB_HOST=127.0.0.1\nDB_PORT=3306\nDB_DATABASE=laravel\nDB_USERNAME=root\nDB_PASSWORD='},
    'postgres': {'details': [['Host', '127.0.0.1'], ['Port', '5432'], ['User', 'postgres'], ['Password', '(empty)']],
                 'env': 'DB_CONNECTION=pgsql\nDB_HOST=127.0.0.1\nDB_PORT=5432\nDB_DATABASE=laravel\nDB_USERNAME=postgres\nDB_PASSWORD='},
    'redis': {'details': [['Host', '127.0.0.1'], ['Port', '6379'], ['Password', '(none)']],
              'env': 'REDIS_CLIENT=phpredis\nREDIS_HOST=127.0.0.1\nREDIS_PORT=6379\nREDIS_PASSWORD=null'},
    'mailpit': {'details': [['SMTP host', '127.0.0.1'], ['SMTP port', '1025'], ['Login', 'none needed'],
                            ['Encryption', 'none'], ['Inbox', 'http://localhost:8025']],
                'env': 'MAIL_MAILER=smtp\nMAIL_SCHEME=null\nMAIL_HOST=127.0.0.1\nMAIL_PORT=1025\nMAIL_USERNAME=null\nMAIL_PASSWORD=null'},
}


def docker_containers():
    """Names of all containers, or None when Docker can't be asked without a password (or isn't running:
    asking would wake the daemon up on every status poll)."""
    if not shutil.which('docker') or subprocess.run(['systemctl', 'is-active', '--quiet', 'docker.service']).returncode:
        return None
    try:
        r = subprocess.run(['docker', 'ps', '-a', '--format', '{{.Names}}'], capture_output=True, text=True, timeout=5)
    except subprocess.TimeoutExpired:
        return None
    return set(r.stdout.split()) if r.returncode == 0 else None


def services_status(cfg):
    """Each service, running or not, and whether its container exists yet (pxm remembers the ones it has seen,
    since Omarchy keeps you out of the docker group and Docker can't always be asked)."""
    seen = set(cfg.get('containers', []))
    existing = docker_containers()
    out = []
    for sid, name, port, url, how in SERVICES:
        kind, target = how.split(':', 1)
        up = port_open(port)
        created = kind == 'systemd' or up or target in seen or (existing is not None and target in existing)
        if kind == 'docker' and created:
            seen.add(target)
        out.append({'id': sid, 'name': name, 'port': port, 'url': url, 'up': up, 'created': created,
                    **service_info(sid, cfg)})
    if seen != set(cfg.get('containers', [])):
        cfg['containers'] = sorted(seen)
        save_config(cfg)
    return out


def remember_container(target):
    cfg = load_config()
    if target not in cfg.get('containers', []):
        cfg['containers'] = sorted(set(cfg.get('containers', [])) | {target})
        save_config(cfg)


def service_info(sid, cfg):
    info = json.loads(json.dumps(SERVICE_INFO.get(sid, {'details': [], 'env': ''})))
    if sid == 'web':
        info['details'][0][1] = str(cfg.get('sites_dir') or '').replace(str(HOME), '~')
    return info


def find_service(name):
    key = name.lower()
    for s in SERVICES:
        if key in (s[0], s[1].lower()) or s[1].lower().startswith(key):
            return s
    die(f"unknown service {name!r}. Services: {', '.join(s[0] for s in SERVICES)}")


def docker_sh(script):
    """Run a docker shell snippet. Omarchy keeps users out of the docker group by default (it's root-equivalent),
    so when the socket refuses us, run it through one admin prompt instead."""
    if not shutil.which('docker'):
        die('this service runs in Docker, which is not installed: sudo pacman -S docker && sudo systemctl enable --now docker')
    r = subprocess.run(['docker', 'info', '--format', '{{.ID}}'], capture_output=True, text=True)
    if r.returncode and 'permission denied' in (r.stderr or '').lower():
        return subprocess.run(['pkexec', 'sh', '-c', script], capture_output=True, text=True)
    if r.returncode:
        die('Docker is not running: sudo systemctl enable --now docker')
    return subprocess.run(['sh', '-c', script], capture_output=True, text=True)


def service(action, name):
    sid, label, port, _, how = find_service(name)
    kind, target = how.split(':', 1)
    if kind == 'systemd':
        cfg = load_config()
        cfg['web_stopped'] = action == 'stop'
        save_config(cfg)
        systemctl('disable' if action == 'stop' else 'enable', '--now', target)
        if action == 'stop':
            systemctl('stop', 'pxm-sites.path')
        else:
            systemctl('enable', '--now', 'pxm-sites.path')
            apply(quiet=True)
    else:
        if action == 'start':
            # first start: create the container (downloading the image can take a minute)
            create = shlex.join(['docker', 'run', '-d', '--restart', 'unless-stopped', '--name', target, *DOCKER_RUN[target]])
            r = docker_sh(f'docker start {target} >/dev/null 2>&1 && echo started || {create}')
        else:
            r = docker_sh(f'docker stop {target}')
        if r.returncode:
            out = (r.stderr or r.stdout).strip().splitlines()
            die(f'could not {action} {label}: {out[-1] if out else "unknown error"}')
        if action == 'start':
            remember_container(target)
            if 'started' not in r.stdout:
                print(f'Downloaded and created {label}.', flush=True)
    import time
    for _ in range(40 if action == 'stop' or kind == 'systemd' else 480):   # wait until the port agrees
        if port_open(port) == (action == 'start'):
            break
        time.sleep(0.25)
    print(f"{label} {'started' if action == 'start' else 'stopped'}"
          + (' (stays stopped after reboot)' if action == 'stop' else ''))


# ------------------------------------------------------------------ share (Cloudflare quick tunnels)
SHARE_PORT_BASE = 8400
SHARE_URL_RE = re.compile(r'https://[a-z0-9-]+\.trycloudflare\.com')


def share_unit(name):
    return f'pxm-share-{name}.service'


def share_log(name):
    return LOGS / f'share-{name}.log'


def active_shares():
    r = systemctl('list-units', '--plain', '--no-legend', '--state=active,activating', 'pxm-share-*', TUNNEL_UNIT)
    active = {m.group(1) for m in re.finditer(r'^pxm-share-(\S+)\.service', r.stdout, re.M)}
    if re.search(r'^pxm-tunnel\.service', r.stdout, re.M):
        cfg = load_config()
        active |= {n for n in cfg.get('shared', []) if cfg.get('share_mode', {}).get(n) == 'domain'}
    return active


def share_url(name):
    cfg = load_config()
    if cfg.get('share_mode', {}).get(name) == 'domain' and cfg.get('share_domain'):
        return f"https://{name}.{cfg['share_domain']}"
    try:
        found = SHARE_URL_RE.findall(share_log(name).read_text(errors='replace'))
    except OSError:
        return ''
    return found[-1] if found else ''


def wait_reachable(url, timeout=60):
    """A new quick-tunnel link needs ~10 s before it answers. Probe it via Cloudflare DNS-over-HTTPS so an early
    'not found' doesn't get cached by this laptop's resolver (which would break the link here for a while)."""
    import time
    end = time.time() + timeout
    while time.time() < end:
        r = subprocess.run(['curl', '-s', '-o', '/dev/null', '-w', '%{http_code}', '--max-time', '8',
                            '--doh-url', 'https://1.1.1.1/dns-query', url], capture_output=True, text=True)
        if r.stdout.strip() not in ('', '000', '530', '502', '503'):
            return True
        time.sleep(2)
    return False


def is_phpmyadmin(path):
    try:
        return '"phpmyadmin/phpmyadmin"' in (Path(path) / 'composer.json').read_text()
    except OSError:
        return (Path(path) / 'config.inc.php').exists() and (Path(path) / 'libraries').is_dir()


def share_warnings(s):
    out = []
    path = Path(s['path'])
    env = path / '.env'
    if env.exists() and re.search(r'^\s*APP_DEBUG\s*=\s*"?true', env.read_text(errors='replace'), re.M | re.I):
        out.append('Debug mode is on (APP_DEBUG=true): if a page errors, visitors see the full error page, '
                   'including values from .env.')
    if (path / 'public/hot').exists():
        out.append('`npm run dev` is running: visitors won\'t get the styles and scripts. '
                   'Stop it and run `npm run build` while sharing.')
    return out


CF_DIR = HOME / '.cloudflared'
TUNNEL_CONFIG = CONF_DIR / 'cloudflared.yml'
TUNNEL_UNIT = 'pxm-tunnel.service'


def cloudflared(*args):
    return subprocess.run([shutil.which('cloudflared') or 'cloudflared', *args], capture_output=True, text=True)


def share_domain_setup(domain):
    """Connect a Cloudflare domain: browser login (once), then a named tunnel for this laptop."""
    if not shutil.which('cloudflared'):
        die('cloudflared is not installed: sudo pacman -S cloudflared')
    domain = domain.strip().lower().removeprefix('https://').removeprefix('http://').strip('/')
    if not re.fullmatch(r'[a-z0-9-]+(\.[a-z0-9-]+)+', domain):
        die(f'"{domain}" does not look like a domain')
    if not (CF_DIR / 'cert.pem').exists():
        print(f'A browser tab will open: pick {domain} and click Authorize.', flush=True)
        if subprocess.run([shutil.which('cloudflared'), 'tunnel', 'login']).returncode or not (CF_DIR / 'cert.pem').exists():
            die('Cloudflare login did not finish. Try again: pxm share domain ' + domain)
    import socket
    tname = 'pxm-' + re.sub(r'[^a-z0-9-]', '-', socket.gethostname().lower())
    try:
        tunnels = json.loads(cloudflared('tunnel', 'list', '-o', 'json').stdout or '[]') or []
    except ValueError:
        tunnels = []
    tid = next((x['id'] for x in tunnels if x.get('name') == tname), None)
    if tid and not (CF_DIR / f'{tid}.json').exists():
        die(f'A tunnel named {tname} exists in your Cloudflare account but its key is not on this laptop. '
            f'Delete it in the Cloudflare dashboard (Zero Trust > Networks > Tunnels) and run this again.')
    if not tid:
        r = cloudflared('tunnel', 'create', tname)
        m = re.search(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', r.stdout + r.stderr)
        if r.returncode or not m:
            die('could not create the tunnel: ' + (r.stderr.strip() or r.stdout.strip()))
        tid = m.group(0)
    cfg = load_config()
    cfg['share_domain'] = domain
    cfg['tunnel'] = {'name': tname, 'id': tid}
    save_config(cfg)
    print(f'Connected. Shared sites now get https://<site>.{domain}')


def share_domain_off():
    cfg = load_config()
    for n in [n for n in cfg.get('shared', []) if cfg.get('share_mode', {}).get(n) == 'domain']:
        unshare(n)
    cfg = load_config()
    cfg['share_domain'] = None
    save_config(cfg)
    print('Sharing uses random *.trycloudflare.com links again')


def write_tunnel_config(cfg):
    """One named tunnel serves every site shared on the domain; returns how many."""
    t = cfg.get('tunnel') or {}
    names = [n for n in cfg.get('shared', []) if cfg.get('share_mode', {}).get(n) == 'domain']
    lines = [f"tunnel: {t.get('id')}", f"credentials-file: {CF_DIR / (str(t.get('id')) + '.json')}", 'ingress:']
    for n in names:
        lines += [f"  - hostname: {n}.{cfg['share_domain']}", f"    service: http://127.0.0.1:{cfg['share_ports'][n]}"]
    lines += ['  - service: http_status:404', '']
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    TUNNEL_CONFIG.write_text('\n'.join(lines))
    return len(names)


def restart_tunnel(cfg):
    n = write_tunnel_config(cfg)
    systemctl('stop', TUNNEL_UNIT)
    if not n:
        return
    systemctl('reset-failed', TUNNEL_UNIT)
    LOGS.mkdir(parents=True, exist_ok=True)
    log = LOGS / 'tunnel.log'
    log.write_text('')
    r = subprocess.run(['systemd-run', '--user', '--quiet', '--collect', f'--unit={TUNNEL_UNIT}',
                        '-p', 'Restart=on-failure', '-p', 'RestartSec=3',
                        '-p', f'StandardOutput=append:{log}', '-p', f'StandardError=append:{log}',
                        shutil.which('cloudflared'), 'tunnel', '--no-autoupdate', '--config', str(TUNNEL_CONFIG), 'run'],
                       capture_output=True, text=True)
    if r.returncode:
        die(f'could not start the tunnel: {r.stderr.strip()}')


def share(name=None, quick=False):
    if not shutil.which('cloudflared'):
        die('cloudflared is not installed: sudo pacman -S cloudflared')
    site_name, s = find_site(name)
    if is_phpmyadmin(s['path']):
        die(f'{site_name}.test is phpMyAdmin, which logs in automatically as root. Sharing it would let anyone '
            'with the link see and change all your databases, so pxm won\'t share it.')
    cfg = load_config()
    if cfg.get('web_stopped'):
        die('The web server is stopped. Start it first: pxm service start web')
    ports = cfg.setdefault('share_ports', {})
    if site_name not in ports:
        used = set(ports.values())
        port = SHARE_PORT_BASE
        while port in used or port_open(port):
            port += 1
        ports[site_name] = port
    domain = None if quick else cfg.get('share_domain')
    if domain:
        host = f'{site_name}.{domain}'
        r = cloudflared('tunnel', 'route', 'dns', cfg['tunnel']['id'], host)
        out = (r.stdout + r.stderr).strip()
        if r.returncode and 'already configured' not in out:
            if 'already exists' in out:
                die(f'{host} already exists in your Cloudflare DNS and points somewhere else. pxm won\'t overwrite it: '
                    f'rename the site folder, or remove that DNS record if you don\'t need it.')
            die(f'could not create {host}: {out.splitlines()[-1] if out else "unknown error"}')
    shared = cfg.setdefault('shared', [])
    if site_name not in shared:
        shared.append(site_name)
    cfg.setdefault('share_mode', {})[site_name] = 'domain' if domain else 'quick'
    save_config(cfg)
    apply(quiet=True)

    if domain:
        systemctl('stop', share_unit(site_name))
        restart_tunnel(cfg)
        url = f'https://{site_name}.{domain}'
        return share_done(site_name, s, url)

    unit = share_unit(site_name)
    if site_name not in active_shares():
        LOGS.mkdir(parents=True, exist_ok=True)
        share_log(site_name).write_text('')
        systemctl('reset-failed', unit)
        r = subprocess.run(['systemd-run', '--user', '--quiet', '--collect', f'--unit={unit}',
                            '-p', 'Restart=on-failure', '-p', 'RestartSec=3',
                            '-p', f'StandardOutput=append:{share_log(site_name)}',
                            '-p', f'StandardError=append:{share_log(site_name)}',
                            shutil.which('cloudflared'), 'tunnel', '--no-autoupdate',
                            '--url', f'http://127.0.0.1:{ports[site_name]}'],
                           capture_output=True, text=True)
        if r.returncode:
            die(f'could not start the tunnel: {r.stderr.strip()}')
    import time
    url = ''
    for _ in range(60):
        url = share_url(site_name)
        if url:
            break
        time.sleep(0.5)
    if not url:
        die(f'The tunnel for {site_name}.test started but no link appeared yet. Check: pxm shares '
            f'(log: {share_log(site_name)})')
    # wl-copy keeps running in the background to serve the clipboard: don't wait on its pipes
    return share_done(site_name, s, url)


def share_done(site_name, s, url):
    ready = wait_reachable(url)
    # if this laptop looked the name up before Cloudflare's record existed, it cached "not found": clear that
    subprocess.run(['resolvectl', 'flush-caches'], capture_output=True)
    copied = shutil.which('wl-copy') is not None and subprocess.run(
        ['wl-copy', url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    for w in share_warnings(s):
        print('  ! ' + w)
    print(f'{site_name}.test is shared at {url}' + ('  (link copied)' if copied else '')
          + ('' if ready else '  (may need another minute to start working)'))
    notify_user(f'{site_name}.test is shared', url + ('\nLink copied to the clipboard.' if copied else ''))
    return url


def unshare(name=None):
    site_name, _ = find_site(name)
    systemctl('stop', share_unit(site_name))
    cfg = load_config()
    if site_name in cfg.get('shared', []):
        cfg['shared'].remove(site_name)
        was_domain = cfg.get('share_mode', {}).pop(site_name, None) == 'domain'
        save_config(cfg)
        apply(quiet=True)
        if was_domain:
            restart_tunnel(cfg)
    print(f'{site_name}.test is no longer shared')


def share_status(site_map):
    """Adds share info to each site; also forgets shares whose tunnel is gone (e.g. after a reboot)."""
    active = active_shares()
    for name, s in site_map.items():
        on = name in active
        s['share'] = {'on': on, 'url': share_url(name) if on else '', 'blocked': is_phpmyadmin(s['path']),
                      'warnings': share_warnings(s) if on else [],
                      'mode': load_config().get('share_mode', {}).get(name, '') if on else ''}
    cfg = load_config()
    stale = [n for n in cfg.get('shared', []) if n not in active]
    if stale:
        cfg['shared'] = [n for n in cfg['shared'] if n in active]
        for n in stale:
            cfg.get('share_mode', {}).pop(n, None)
        save_config(cfg)
        apply(quiet=True)


# ------------------------------------------------------------------ node (managed by mise)
NODE_INDEX = 'https://nodejs.org/dist/index.json'
MISE_GLOBAL = HOME / '.config/mise/config.toml'
NODE_FILES = ('.nvmrc', '.node-version')
MISE_FILES = ('mise.local.toml', 'mise.toml', '.mise.toml', '.config/mise.toml', '.tool-versions')


def nkey(v):
    return tuple(int(x) for x in re.findall(r'\d+', str(v))[:3])


def mise_bin():
    b = shutil.which('mise') or str(HOME / '.local/bin/mise')
    if not Path(b).exists():
        die('mise is not installed (Omarchy normally ships it): sudo pacman -S mise')
    return b


def mise(*args, cwd=None):
    return subprocess.run([mise_bin(), *args], capture_output=True, text=True, cwd=cwd or str(HOME))


def mise_error(r, fallback):
    lines = [l for l in (r.stderr or '').strip().splitlines() if l.strip()]
    return lines[-1] if lines else fallback


def node_installed():
    """Installed Node versions, newest first."""
    try:
        data = json.loads(mise('ls', '--json', '--installed', 'node').stdout or '[]')
    except ValueError:
        data = []
    return sorted({d['version'] for d in data if d.get('installed')}, key=nkey, reverse=True)


def node_index(max_age=6 * 3600):
    """Newest release of each Node major line: {'24': {'version': '24.11.0', 'lts': 'Krypton'}} (cached 6 h)."""
    import time
    cache = CACHE / 'node-index.json'
    if max_age and cache.exists() and time.time() - cache.stat().st_mtime < max_age:
        return json.loads(cache.read_text())
    try:
        with urllib.request.urlopen(urllib.request.Request(NODE_INDEX, headers=UA), timeout=10) as r:
            data = json.loads(r.read().decode())
    except Exception:
        return json.loads(cache.read_text()) if cache.exists() else {}
    found = {}
    for d in data:
        v = d['version'].lstrip('v')
        m = v.split('.')[0]
        if int(m) >= 16 and (m not in found or nkey(v) > nkey(found[m]['version'])):
            found[m] = {'version': v, 'lts': d.get('lts') or ''}
    CACHE.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(found))
    return found


def node_lines():
    """What to offer for install: every LTS line from 18 up, plus the newest (current) line."""
    idx = node_index()
    if not idx:
        return []
    newest = max(idx, key=int)
    keep = [m for m in idx if int(m) >= 18 and (idx[m]['lts'] or m == newest)]
    return [{'major': m, 'version': idx[m]['version'], 'lts': idx[m]['lts']} for m in sorted(keep, key=int, reverse=True)]


def toml_node(f):
    """The node version a mise.toml / .tool-versions file asks for, if any."""
    try:
        if f.name == '.tool-versions':
            for line in f.read_text().splitlines():
                parts = line.split()
                if len(parts) > 1 and parts[0] in ('node', 'nodejs'):
                    return parts[1]
            return None
        import tomllib
        v = tomllib.loads(f.read_text()).get('tools', {}).get('node')
        if isinstance(v, list):
            v = v[0] if v else None
        if isinstance(v, dict):
            v = v.get('version')
        return str(v) if v else None
    except Exception:
        return None


def node_global_spec():
    return toml_node(MISE_GLOBAL) if MISE_GLOBAL.exists() else None


def node_nvmrc_enabled():
    return 'node' in mise('settings', 'get', 'idiomatic_version_file_enable_tools').stdout


def node_project_spec(path, nvmrc=True):
    """(spec, file) pinning Node for this folder (searching upwards), or (None, None) = global."""
    p = Path(path).expanduser().resolve()
    for d in [p, *p.parents]:
        if d == HOME or d == d.parent:
            break
        for name in MISE_FILES:
            f = d / name
            if f.is_file():
                v = toml_node(f)
                if v:
                    return v, f
        if nvmrc:
            for name in NODE_FILES:
                f = d / name
                if f.is_file():
                    first = (f.read_text().strip().splitlines() or [''])[0].strip()
                    if first:
                        return first, f
    return None, None


def node_resolve(spec, inst=None):
    """Which installed version a spec ('24', 'lts/*', 'latest', '24.11.0') means, or None if not installed."""
    inst = node_installed() if inst is None else inst
    if not spec:
        return None
    s = str(spec).strip().lower().removeprefix('node@').lstrip('v')
    if s in ('latest', 'node', 'current', 'stable'):
        return inst[0] if inst else None
    if s.startswith('lts'):
        name = s.split('/', 1)[1] if '/' in s else '*'
        idx = node_index()
        majors = {m for m, d in idx.items() if d['lts'] and name in ('*', '', d['lts'].lower())}
        found = [v for v in inst if v.split('.')[0] in majors]
        return found[0] if found else None
    if re.fullmatch(r'\d+(\.\d+){0,2}', s):
        found = [v for v in inst if v == s or v.startswith(s + '.')]
        return found[0] if found else None
    return None


def node_target(spec):
    """'24' / 'lts' / 'latest' -> the exact newest version to install."""
    s = str(spec).strip().lower().removeprefix('node@').lstrip('v')
    idx = node_index()
    if s in ('lts', 'lts/*'):
        ms = [m for m, d in idx.items() if d['lts']]
        return idx[max(ms, key=int)]['version'] if ms else 'lts'
    if s in ('latest', 'current', 'node'):
        return idx[max(idx, key=int)]['version'] if idx else 'latest'
    if s in idx:
        return idx[s]['version']
    return s


def node_install(spec):
    exact = node_target(spec)
    if exact in node_installed():
        print(f'Node {exact} is already installed')
        return exact
    CACHE.mkdir(parents=True, exist_ok=True)
    marker = CACHE / f"node-installing-{exact.split('.')[0]}"
    marker.write_text(exact)
    try:
        print(f'Installing Node {exact}…', flush=True)
        r = mise('install', f'node@{exact}')
        if r.returncode:
            die(mise_error(r, f'mise could not install Node {exact}'))
    finally:
        marker.unlink(missing_ok=True)
    print(f'Node {exact} installed')
    return exact


def node_use(spec):
    s = str(spec).strip().removeprefix('node@').lstrip('v')
    r = mise('use', '-g', f'node@{s}')
    if r.returncode:
        die(mise_error(r, f'mise could not switch to Node {s}'))
    print(f"Global Node is now {s} ({node_resolve(s) or 'installed'})")


def node_isolate(spec, path=None):
    d = Path(path or os.getcwd()).expanduser().resolve()
    s = str(spec).strip().removeprefix('node@').lstrip('v')
    if not node_nvmrc_enabled():
        node_nvmrc(True)
    for name in MISE_FILES:   # project already pins node in its own mise config: update that
        f = d / name
        if f.is_file() and toml_node(f) and name != '.tool-versions':
            r = mise('use', '--path', str(f), f'node@{s}', cwd=str(d))
            if r.returncode:
                die(mise_error(r, 'mise failed'))
            print(f'{d.name}: Node {s} (in {name})')
            return
    (d / '.nvmrc').write_text(s + '\n')
    for name in ('.node-version',):
        (d / name).unlink(missing_ok=True)
    if not node_resolve(s):
        node_install(s)
    print(f'{d.name}: Node {s} (.nvmrc)')


def node_unisolate(path=None):
    d = Path(path or os.getcwd()).expanduser().resolve()
    removed = False
    for name in NODE_FILES:
        if (d / name).exists():
            (d / name).unlink()
            removed = True
    for name in MISE_FILES:
        f = d / name
        if f.is_file() and toml_node(f) and name != '.tool-versions':
            mise('unuse', '--path', str(f), 'node', cwd=str(d))
            removed = True
    print(f'{d.name}: uses the global Node' if removed else f'{d.name} was not pinned')


def node_uninstall(version):
    v = str(version).strip().lstrip('v')
    if v not in node_installed():
        die(f'Node {v} is not installed (see: pxm node list)')
    r = mise('uninstall', f'node@{v}')
    if r.returncode:
        die(mise_error(r, f'mise could not remove Node {v}'))
    print(f'Removed Node {v}')


def node_nvmrc(on):
    if on and not node_nvmrc_enabled():
        mise('settings', 'add', 'idiomatic_version_file_enable_tools', 'node')
    elif not on and node_nvmrc_enabled():
        cur = mise('settings', 'get', 'idiomatic_version_file_enable_tools').stdout
        rest = [x for x in re.findall(r'[A-Za-z0-9_.-]+', cur) if x != 'node']
        mise('settings', 'unset', 'idiomatic_version_file_enable_tools')
        for x in rest:
            mise('settings', 'add', 'idiomatic_version_file_enable_tools', x)
    print('.nvmrc / .node-version files: ' + ('followed' if node_nvmrc_enabled() else 'ignored'))


def node_status(site_map=None):
    inst = node_installed()
    spec = node_global_spec()
    g = node_resolve(spec, inst) if spec else None
    idx = node_index()
    newest = {}
    for v in inst:
        newest.setdefault(v.split('.')[0], v)
    nvmrc = node_nvmrc_enabled()
    for s in (site_map or {}).values():
        pspec, f = node_project_spec(s['path'], nvmrc)
        s['node_pinned'] = bool(pspec)
        s['node_spec'] = pspec or ''
        s['node_file'] = f.name if f else ''
        s['node'] = node_resolve(pspec, inst) if pspec else (g or '')
        s['node_missing'] = bool(pspec) and not s['node']
        s['node'] = s['node'] or ''
    def update_for(v):
        m = v.split('.')[0]
        latest = idx.get(m, {}).get('version', '')
        return latest if newest.get(m) == v and latest and nkey(latest) > nkey(v) else ''
    return {
        'available': bool(shutil.which('mise')),
        'global_spec': spec or '',
        'global': g or '',
        'global_major': g.split('.')[0] if g else '',
        'installed': [{'version': v, 'major': v.split('.')[0], 'lts': idx.get(v.split('.')[0], {}).get('lts', ''),
                       'update': update_for(v)} for v in inst],
        'majors': [{'major': m, 'version': v, 'lts': idx.get(m, {}).get('lts', '')}
                   for m, v in sorted(newest.items(), key=lambda kv: int(kv[0]), reverse=True)],
        'lines': [dict(l, installed=l['major'] in newest) for l in node_lines()],
        'installing': sorted(p.name.removeprefix('node-installing-') for p in CACHE.glob('node-installing-*')) if CACHE.exists() else [],
        'nvmrc': nvmrc,
    }


# ------------------------------------------------------------------ apps (editor, terminal, files, browser)
# id, name, binaries, runs inside a terminal?
APPS = {
    'editor': [
        ('zed', 'Zed', ['zeditor', 'zed'], False), ('code', 'VS Code', ['code'], False),
        ('codium', 'VSCodium', ['codium'], False), ('cursor', 'Cursor', ['cursor'], False),
        ('windsurf', 'Windsurf', ['windsurf'], False), ('phpstorm', 'PhpStorm', ['phpstorm', 'phpstorm.sh'], False),
