        ('lf', 'lf', ['lf'], True), ('ranger', 'ranger', ['ranger'], True),
    ],
    'browser': [
        ('chromium', 'Chromium', ['chromium'], False), ('chrome', 'Google Chrome', ['google-chrome-stable', 'google-chrome'], False),
        ('brave', 'Brave', ['brave', 'brave-browser'], False), ('firefox', 'Firefox', ['firefox'], False),
        ('zen', 'Zen', ['zen-browser', 'zen'], False), ('vivaldi', 'Vivaldi', ['vivaldi-stable', 'vivaldi'], False),
        ('edge', 'Edge', ['microsoft-edge-stable'], False), ('helium', 'Helium', ['helium-browser', 'helium'], False),
        ('librewolf', 'LibreWolf', ['librewolf'], False),
    ],
}
APP_KINDS = {'editor': 'Editor', 'terminal': 'Terminal', 'files': 'File manager', 'browser': 'Browser'}
EXTRA_PATH = os.pathsep.join([str(HOME / '.local/share/JetBrains/Toolbox/scripts'), '/var/lib/flatpak/exports/bin',
                              str(HOME / '.local/share/flatpak/exports/bin')])


def app_bin(binaries):
    for b in binaries:
        found = shutil.which(b) or shutil.which(b, path=EXTRA_PATH)
        if found:
            return found
    return None


def desktop_name(desktop_id):
    for d in (HOME / '.local/share/applications', Path('/usr/share/applications')):
        f = d / desktop_id
        if f.exists():
            for line in f.read_text(errors='replace').splitlines():
                if line.startswith('Name='):
                    return line[5:].strip()
    return desktop_id.removesuffix('.desktop')


def cmd_out(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ''


def system_app(kind):
    """What Omarchy currently uses: (matching APPS entry or None, display name)."""
    if kind == 'editor':
        cur = cmd_out(['omarchy-default-editor']) or 'nvim'
    elif kind == 'terminal':
        cur = cmd_out(['omarchy-default-terminal']) or 'xdg-terminal-exec'
    elif kind == 'files':
        did = cmd_out(['xdg-mime', 'query', 'default', 'inode/directory'])
        cur = did.removesuffix('.desktop').split('.')[-1].lower() if did else ''
    else:
        did = cmd_out(['env', '-u', 'BROWSER', 'xdg-settings', 'get', 'default-web-browser'])
        cur = did.removesuffix('.desktop').lower() if did else ''
        cur = {'google-chrome': 'chrome', 'brave-browser': 'brave', 'microsoft-edge': 'edge'}.get(cur, cur)
    for entry in APPS[kind]:
        if cur == entry[0] or cur in entry[2]:
            return entry, entry[1]
    if kind == 'files' and did:
        return None, desktop_name(did)
    if kind == 'browser' and did:
        return None, desktop_name(did)
    return None, cur or 'system'


def prefs(cfg=None):
    cfg = cfg or load_config()
    chosen = cfg.get('apps', {})
    out = {}
    for kind, label in APP_KINDS.items():
        _, sys_name = system_app(kind)
        opts = [{'value': 'system', 'label': f'System default ({sys_name})'}]
        for i, name, bins, tui in APPS[kind]:
            if app_bin(bins):
                opts.append({'value': i, 'label': name + (' (in terminal)' if tui else '')})
        opts.append({'value': 'custom', 'label': 'Custom command…'})
        value = chosen.get(kind, 'system')
        if value not in [o['value'] for o in opts]:
            opts.insert(1, {'value': value, 'label': value + ' (not found)'})
        out[kind] = {'label': label, 'value': value, 'custom': chosen.get(kind + '_custom', ''), 'options': opts}
    return out


def set_pref(kind, value, custom=None):
    if kind not in APP_KINDS:
        die(f"unknown app type '{kind}' (use: {', '.join(APP_KINDS)})")
    ids = ['system', 'custom'] + [e[0] for e in APPS[kind]]
    if value not in ids:
        die(f"unknown {kind} '{value}' (choose: {', '.join(ids)})")
    cfg = load_config()
    apps = cfg.setdefault('apps', {})
    apps[kind] = value
    if custom is not None:
        apps[kind + '_custom'] = custom
    if value == 'custom' and not apps.get(kind + '_custom'):
        print(f"Now set the command: pxm prefs set {kind} custom '<command> {{path}}'")
    save_config(cfg)
    names = {e[0]: e[1] for e in APPS[kind]}
    print(f"{APP_KINDS[kind]}: " + ('system default' if value == 'system' else names.get(value, 'custom command')))


def spawn(argv, cwd=None):
    """Start an app fully detached, in its own systemd scope (survives bar restarts)."""
    launcher = ['setsid', 'uwsm-app', '--'] if shutil.which('uwsm-app') else ['setsid']
    try:
        subprocess.Popen(launcher + list(argv), cwd=cwd or str(HOME), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        notify_user('pxm could not open the app', str(e))
        die(str(e))


def custom_argv(template, path):
    parts = shlex.split(template)
    if not parts:
        die('the custom command is empty')
    if not any('{path}' in x for x in parts):
        parts.append('{path}')
    argv = [x.replace('{path}', path) for x in parts]
    if not shutil.which(argv[0]) and not Path(argv[0]).exists():
        notify_user('pxm: command not found', argv[0])
        die(f'command not found: {argv[0]}')
    return argv


def pick(kind):
    """The app pxm should use: ('system'|'custom'|entry, binary or template)."""
    apps = load_config().get('apps', {})
    value = apps.get(kind, 'system')
    if value == 'custom':
        return 'custom', apps.get(kind + '_custom', '')
    for entry in APPS[kind]:
        if entry[0] == value:
            b = app_bin(entry[2])
            if b:
                return entry, b
    return 'system', None


def terminal_argv(cwd, cmd=None):
    choice, b = pick('terminal')
    if choice == 'custom' and b:
        argv = custom_argv(b, cwd)
        return argv + (['-e'] + cmd if cmd else [])
    if choice in ('system', 'custom'):
        entry, _ = system_app('terminal')
        b = app_bin(entry[2]) if entry else None
        if not b:
            return ['xdg-terminal-exec', f'--dir={cwd}'] + (['-e'] + cmd if cmd else [])
        choice = entry
    tid = choice[0]
    if tid == 'foot':
        return [b, f'--working-directory={cwd}'] + (cmd or [])
    if tid in ('alacritty', 'konsole'):
        return [b, '--working-directory' if tid == 'alacritty' else '--workdir', cwd] + (['-e'] + cmd if cmd else [])
    if tid == 'ghostty':
        return [b, f'--working-directory={cwd}'] + (['-e'] + cmd if cmd else [])
    if tid == 'kitty':
        return [b, '--directory', cwd] + (cmd or [])
    if tid == 'wezterm':
        return [b, 'start', '--cwd', cwd] + (['--'] + cmd if cmd else [])
    if tid == 'gnome-terminal':
        return [b, f'--working-directory={cwd}'] + (['--'] + cmd if cmd else [])
    if tid == 'ptyxis':
        return [b, '--new-window', '-d', cwd] + (['--'] + cmd if cmd else [])
    if tid == 'warp' and cmd:   # Warp can't run a command on start; use the system terminal for that
        return ['xdg-terminal-exec', f'--dir={cwd}', '-e'] + cmd
    return [b]


def open_terminal(path=None, cmd=None):
    cwd = str(Path(path or os.getcwd()).expanduser().resolve())
    spawn(terminal_argv(cwd, cmd), cwd)


def open_editor(path=None):
    target = Path(path or os.getcwd()).expanduser().resolve()
    cwd = str(target if target.is_dir() else target.parent)
    arg = '.' if target.is_dir() else str(target)
    choice, b = pick('editor')
    if choice == 'custom' and b:
        return spawn(custom_argv(b, str(target)), cwd)
    if choice in ('system', 'custom'):
        entry, _ = system_app('editor')
        b = app_bin(entry[2]) if entry else None
        if not b:
            return spawn(['omarchy-launch-editor', str(target)], cwd)
        choice = entry
    if choice[3]:
        return spawn(terminal_argv(cwd, [b, arg]), cwd)
    spawn([b, str(target)], cwd)


def open_files(path=None):
    target = str(Path(path or os.getcwd()).expanduser().resolve())
    choice, b = pick('files')
    if choice == 'custom' and b:
        return spawn(custom_argv(b, target), target)
    if choice == 'system':
        return spawn(['xdg-open', target], target)
    if choice[3]:
        return spawn(terminal_argv(target, [b, target]), target)
    spawn([b, target], target)


def open_url(url):
    choice, b = pick('browser')
    if choice == 'custom' and b:
        return spawn(custom_argv(b, url))
    if choice == 'system':
        return spawn(['omarchy-launch-browser', url] if shutil.which('omarchy-launch-browser') else ['xdg-open', url])
    spawn([b, url])


# ------------------------------------------------------------------ info, logs, mail, ui
def php_info():
    out = []
    for name in (['system'] if Path(SYSTEM_PHP).exists() else []) + list(installed()):
        if name == 'system':
            binary, ini, kind, version, label = SYSTEM_PHP, '/etc/php/php.ini', 'system', full_version('system'), 'system'
        else:
            binary, ini, kind, version, label = str(PHPS / name / 'bin/php'), str(PHPS / name / 'etc/php.ini'), build_kind(name), name, minor(name)
            link = PHPS / minor(name)
            if not (link.is_symlink() and os.readlink(link) == name):
                label = minor(name) + ' (older)'
        env = dict(os.environ)
        if name != 'system':
            env.update(PHPRC=str(PHPS / name / 'etc'), PHP_INI_SCAN_DIR=str(PHPS / name / 'etc/conf.d'))
        mods = subprocess.run([binary, '-m'], capture_output=True, text=True, env=env).stdout
        exts = sorted({l.strip() for l in mods.splitlines() if l.strip() and not l.startswith('[')}, key=str.lower)
        out.append({'name': name, 'label': label, 'version': version, 'kind': kind, 'ini': ini, 'extensions': exts,
                    'active_minor': label == minor(name) or name == 'system'})
    return out


def logs(name=None, lines=80):
    site_name, s = find_site(name)
    files = []
    lv = Path(s['path']) / 'storage/logs/laravel.log'
    if lv.exists():
        files.append(('Laravel log', lv))
    files.append((f"PHP {s['php']} errors", LOGS / f"php-{s['php']}.log"))
    files.append((f"PHP-FPM {s['php']}", LOGS / f"php-{s['php']}-fpm.log"))
    out = []
    for label, path in files:
        text = ''
        if path.exists():
            with open(path, 'rb') as f:
                f.seek(0, 2)
                size = f.tell()
                f.seek(max(0, size - 64 * 1024))
                text = '\n'.join(f.read().decode(errors='replace').splitlines()[-lines:])
        out.append({'label': label, 'path': str(path), 'exists': path.exists(), 'text': text or '(empty)'})
    return {'site': site_name, 'files': out}


def mail_test(to='you@example.test'):
    import smtplib
    from email.message import EmailMessage
    msg = EmailMessage()
    msg['From'] = 'pxm <pxm@localhost>'
    msg['To'] = to
    msg['Subject'] = 'pxm test email: Mailpit is working'
    msg.set_content('If you can read this in Mailpit (http://localhost:8025), your local SMTP server works.\n\n'
                    'Laravel .env:\n' + SERVICE_INFO['mailpit']['env'].replace('\\n', '\n') + '\n')
    try:
        with smtplib.SMTP('127.0.0.1', 1025, timeout=5) as s:
            s.send_message(msg)
    except OSError as e:
        die(f'Mailpit is not reachable on 127.0.0.1:1025 ({e}). Is it running? pxm service start mailpit')
    print('Test email sent. Open http://localhost:8025 to see it.')


def ui(section='sites'):
    payload = json.dumps({'section': section})
    r = subprocess.run(['omarchy-shell', 'shell', 'summon', 'pxm', payload], capture_output=True, text=True)
    if r.returncode:
        die(r.stderr.strip() or 'could not open the pxm window')

# ------------------------------------------------------------------ setup / doctor / uninstall
PACKAGES = ['caddy', 'dnsmasq', 'nss', 'cloudflared', 'php', 'php-fpm', 'composer']
DNS_IP = '127.0.0.2'              # dnsmasq answers here, and only for *.test
DNS_LINK = 'pxmdns'               # dummy link that tells systemd-resolved to send *.test lookups to dnsmasq
ETC_DIR = Path('/etc/pxm')
SYSTEM_UNIT_DIR = Path('/etc/systemd/system')
NM_CONF = Path('/etc/NetworkManager/conf.d/50-pxm-unmanaged.conf')
SYSCTL_CONF = Path('/etc/sysctl.d/50-pxm-web-ports.conf')
USER_UNIT_DIR = HOME / '.config/systemd/user'
USER_UNITS = ['pxm-caddy.service', 'pxm-fpm@.service', 'pxm-sites.path', 'pxm-sites.service']
SHELL_RCS = [HOME / '.bashrc', HOME / '.zshrc']
HYPR_CONF = HOME / '.config/hypr/hyprland.lua'
BLOCK_BEGIN = '>>> pxm (managed by pxm setup, removed by pxm uninstall) >>>'
BLOCK_END = '<<< pxm <<<'

DNSMASQ_CONF = f"""# pxm: answer every *.test name with this machine.
# Only *.test lookups are sent here (see pxm-dns-route.service).
listen-address={DNS_IP}
bind-interfaces
port=53
no-resolv
no-hosts
address=/test/127.0.0.1
address=/test/::1
"""

DNS_UNIT = f"""[Unit]
Description=pxm: resolve *.test to this machine
After=network.target
Before=nss-lookup.target

[Service]
ExecStart=/usr/bin/dnsmasq --keep-in-foreground --conf-file={ETC_DIR}/dnsmasq.conf --user=dnsmasq --group=dnsmasq --pid-file=
Restart=on-failure

[Install]
WantedBy=multi-user.target
"""

# systemd-resolved sends a lookup to the DNS server of the link whose search domain matches, so a dummy link
# with domain ~test routes *.test (and nothing else) to dnsmasq. This works even when NetworkManager forces a
# global DNS server, which ignores per-connection DNS settings.
DNS_ROUTE_UNIT = f"""[Unit]
Description=pxm: route only *.test lookups to pxm-dns
After=systemd-resolved.service pxm-dns.service NetworkManager.service
Wants=pxm-dns.service
PartOf=systemd-resolved.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/ip link add {DNS_LINK} type dummy
ExecStart=/usr/bin/ip addr replace 192.0.2.53/32 dev {DNS_LINK}
ExecStart=/usr/bin/ip link set {DNS_LINK} up
ExecStart=/usr/bin/resolvectl dns {DNS_LINK} {DNS_IP}
ExecStart=/usr/bin/resolvectl domain {DNS_LINK} ~test
ExecStart=/usr/bin/resolvectl default-route {DNS_LINK} false
ExecStart=/usr/bin/resolvectl dnsovertls {DNS_LINK} no
ExecStop=-/usr/bin/ip link del {DNS_LINK}

[Install]
WantedBy=multi-user.target systemd-resolved.service
"""

NM_UNMANAGED = f"""# pxm: the {DNS_LINK} dummy link is managed by pxm-dns-route.service, not NetworkManager
[keyfile]
unmanaged-devices=interface-name:{DNS_LINK}
"""

SYSCTL_PORTS = """# pxm: let the web server (running as you, not root) use ports 80 and 443
net.ipv4.ip_unprivileged_port_start = 80
"""


def user_units(cfg):
    return {
        'pxm-caddy.service': """[Unit]
Description=pxm: web server for *.test sites (Caddy)
After=network.target

[Service]
ExecStart=/usr/bin/caddy run --config %h/.config/pxm/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config %h/.config/pxm/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
""",
        'pxm-fpm@.service': """[Unit]
Description=pxm: PHP-FPM %i for *.test sites
PartOf=pxm-caddy.service

[Service]
RuntimeDirectory=pxm-fpm-%i
Environment=PHP_INI_SCAN_DIR=%h/.local/share/pxm/php/%i/etc/conf.d
ExecStart=%h/.local/share/pxm/php/%i/bin/php-fpm --nodaemonize -y %h/.local/share/pxm/php/%i/etc/php-fpm.conf -c %h/.local/share/pxm/php/%i/etc/php.ini
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
""",
        'pxm-sites.path': f"""[Unit]
Description=pxm: notice new or removed folders in the sites folder

[Path]
PathChanged={cfg['sites_dir']}
Unit=pxm-sites.service

[Install]
WantedBy=default.target
""",
        'pxm-sites.service': f"""[Unit]
Description=pxm: refresh *.test sites

[Service]
Type=oneshot
ExecStart={LINK} apply --quiet
""",
    }


def step(msg):
    print(f'\n\033[1m== {msg}\033[0m' if sys.stdout.isatty() else f'\n== {msg}', flush=True)


def ok(msg):
    print(f'   ✓ {msg}', flush=True)


def warn(msg):
    print(f'   ! {msg}', flush=True)


def ask(question, default=''):
    if not sys.stdin.isatty():
        return default
    try:
        answer = input(f'{question} [{default}]: ' if default else f'{question}: ').strip()
    except EOFError:
        return default
    return answer or default


def default_sites_dir():
    return str(HOME / 'Work/sites') if (HOME / 'Work').is_dir() else str(HOME / 'Sites')


def is_ready(cfg=None):
    cfg = cfg or load_config()
    return bool(cfg.get('sites_dir')) and (USER_UNIT_DIR / 'pxm-caddy.service').exists()


def upsert_block(path, comment, lines, before=None):
    """Write `lines` between pxm's marker comments in a config file (replacing an older block).
    A new block goes above the line `before` if the file has it, else at the end."""
    text = path.read_text() if path.exists() else ''
    begin, end = f'{comment} {BLOCK_BEGIN}', f'{comment} {BLOCK_END}'
    block = '\n'.join([begin, *lines, end])
    if begin in text and end in text:
        text = text[:text.index(begin)] + block + text[text.index(end) + len(end):]
    elif before and before in text.splitlines():
        lines = text.splitlines(keepends=True)
        i = [l.rstrip('\n') for l in lines].index(before)
        while i > 0 and lines[i - 1].startswith('#'):    # keep the comment that explains that line with it
            i -= 1
        text = ''.join(lines[:i]) + block + '\n\n' + ''.join(lines[i:])
    else:
        text = text.rstrip('\n') + ('\n\n' if text.strip() else '') + block + '\n'
    path.write_text(text)


def remove_block(path, comment):
    if not path.exists():
        return False
    text = path.read_text()
    begin, end = f'{comment} {BLOCK_BEGIN}', f'{comment} {BLOCK_END}'
    if begin not in text or end not in text:
        return False
    before, after = text[:text.index(begin)].rstrip('\n'), text[text.index(end) + len(end):].lstrip('\n')
    if before and after:
        text = before + '\n\n' + after
    else:
        text = (before + '\n' if before else '') + after
    path.write_text(text)
    return True


def omarchy_plugin_enabled():
    try:
        plugins = json.loads(cmd_out(['omarchy', 'plugin', 'list', '--json']) or '[]')
    except ValueError:
        return None
    return any(x.get('id') == PLUGIN_ID and x.get('enabled') for x in plugins)


def run_root(action, *args):
    """The parts that need admin rights run in one go, behind one password prompt."""
    r = subprocess.run(['pkexec', '/usr/bin/python3', str(SELF), '_root', action, *args])
    if r.returncode == 126 or r.returncode == 127:
        die('the password prompt was cancelled; nothing was changed. Run it again when ready.')
    if r.returncode:
        die(f'the admin step failed (exit {r.returncode}); see the messages above')


def root_report_path(uid):
    """Where the admin step leaves notes for the rest of setup (the user's private runtime folder)."""
    return Path(f'/run/user/{uid}/pxm-setup-report.json')


def root_main(action, args=()):
    """Runs as root (via pkexec) for the user in PKEXEC_UID."""
    import pwd
    if os.geteuid() != 0 or 'PKEXEC_UID' not in os.environ:
        die('this part runs through pkexec; use: pxm setup')
    user = pwd.getpwuid(int(os.environ['PKEXEC_UID']))
    home = Path(user.pw_dir)
    ca_root = home / '.local/share/caddy/pki/authorities/local/root.crt'

    def sh(*argv, check=True, quiet=False):
        r = subprocess.run(argv, capture_output=quiet, text=True)
        if check and r.returncode:
            die(f"failed: {' '.join(argv)}")
        return r

    if action == 'setup':
        print('   Installing packages (skips the ones you already have)…', flush=True)
        sh('pacman', '-S', '--needed', '--noconfirm', *PACKAGES)
        ETC_DIR.mkdir(exist_ok=True)
        (ETC_DIR / 'dnsmasq.conf').write_text(DNSMASQ_CONF)
        (SYSTEM_UNIT_DIR / 'pxm-dns.service').write_text(DNS_UNIT)
        (SYSTEM_UNIT_DIR / 'pxm-dns-route.service').write_text(DNS_ROUTE_UNIT)
        if NM_CONF.parent.is_dir():
            NM_CONF.write_text(NM_UNMANAGED)
            sh('nmcli', 'general', 'reload', 'conf', check=False, quiet=True)
        SYSCTL_CONF.write_text(SYSCTL_PORTS)
        sh('sysctl', '-q', '-p', str(SYSCTL_CONF))
        sh('systemctl', 'daemon-reload')
        sh('systemctl', 'enable', '--now', 'pxm-dns.service')
        sh('systemctl', 'enable', 'pxm-dns-route.service', quiet=True)
        sh('systemctl', 'restart', 'pxm-dns-route.service')
        print('   ✓ *.test addresses point to this computer', flush=True)
        if not ca_root.exists():
            # Caddy makes its local certificate authority the first time it runs; run it briefly as the user
            import time
            tmp = Path(tempfile.mkdtemp(prefix='pxm-ca-'))
            (tmp / 'Caddyfile').write_text('{\n\tadmin off\n\tlocal_certs\n\tskip_install_trust\n}\n')
            os.chmod(tmp, 0o755)
            os.chmod(tmp / 'Caddyfile', 0o644)
            proc = subprocess.Popen(['runuser', '-u', user.pw_name, '--', 'env', f'HOME={home}',
                                     f'XDG_DATA_HOME={home}/.local/share', f'XDG_CONFIG_HOME={home}/.config',
                                     '/usr/bin/caddy', 'run', '--config', str(tmp / 'Caddyfile'), '--adapter', 'caddyfile'],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for _ in range(60):
                if ca_root.exists():
                    break
                time.sleep(0.25)
            proc.terminate()
            proc.wait()
            shutil.rmtree(tmp, ignore_errors=True)
        if not ca_root.exists():
            die('Caddy did not create its HTTPS certificate')
        sh('install', '-m', '644', str(ca_root), CA_ANCHOR)
        sh('trust', 'extract-compat')
        print('   ✓ HTTPS certificate trusted system-wide', flush=True)
        wanted = [x for x in (args[args.index('--services') + 1] if '--services' in args else '').split(',') if x]
        containers = set()
        if shutil.which('docker'):
            for sid, label, port, url, how in SERVICES:
                target = how.split(':', 1)[1]
                if sid not in wanted:
                    continue
                if sh('docker', 'start', target, check=False, quiet=True).returncode == 0:
                    print(f'   ✓ {label} is running', flush=True)
                    continue
                print(f'   Downloading {label} (first time only, about a minute)…', flush=True)
                r = sh('docker', 'run', '-d', '--restart', 'unless-stopped', '--name', target, *DOCKER_RUN[target],
                       check=False, quiet=True)
                if r.returncode:
                    lines = (r.stderr or r.stdout).strip().splitlines()
                    print(f"   ! could not set up {label}: {lines[-1] if lines else 'unknown error'}", flush=True)
                else:
                    print(f'   ✓ {label} is running', flush=True)
            r = sh('docker', 'ps', '-a', '--format', '{{.Names}}', check=False, quiet=True)
            containers = set(r.stdout.split()) & {how.split(':', 1)[1] for _, _, _, _, how in SERVICES}
        report = root_report_path(user.pw_uid)
        report.unlink(missing_ok=True)
        fd = os.open(report, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, 'w') as f:
            f.write(json.dumps({'containers': sorted(containers)}))
        os.chown(report, user.pw_uid, user.pw_gid)
    elif action == 'uninstall':
        sh('systemctl', 'disable', '--now', 'pxm-dns-route.service', 'pxm-dns.service', check=False, quiet=True)
        for f in (SYSTEM_UNIT_DIR / 'pxm-dns.service', SYSTEM_UNIT_DIR / 'pxm-dns-route.service',
                  NM_CONF, SYSCTL_CONF, Path(CA_ANCHOR)):
            f.unlink(missing_ok=True)
        shutil.rmtree(ETC_DIR, ignore_errors=True)
        sh('ip', 'link', 'del', DNS_LINK, check=False, quiet=True)
        sh('systemctl', 'daemon-reload')
        if NM_CONF.parent.is_dir():
            sh('nmcli', 'general', 'reload', 'conf', check=False, quiet=True)
        sh('sysctl', '-q', '-w', 'net.ipv4.ip_unprivileged_port_start=1024', check=False)
        sh('trust', 'extract-compat', check=False)
        sh('resolvectl', 'flush-caches', check=False, quiet=True)
        print('   ✓ removed the *.test DNS, port and certificate settings', flush=True)
    else:
        die(f'unknown admin action {action!r}')


SERVICE_CHOICES = {'mysql': 'MySQL', 'postgres': 'PostgreSQL', 'redis': 'Redis', 'mailpit': 'Mailpit'}


def choose_services(answer=None):
    """'mysql mailpit' / 'mysql,mailpit' / 'all' / 'none' -> ['mysql', 'mailpit']"""
    if answer is None:
        if not sys.stdin.isatty():
            return []
        print('\nDatabases and mail run in Docker. Pick the ones you want now; the rest can be switched on any time')
        print('from the bar or the pxm window (the first start downloads it, about a minute).')
        print('  ' + '   '.join(f'{k} ({v})' for k, v in SERVICE_CHOICES.items()))
        answer = ask('Which ones? e.g. "mysql mailpit", "all" or "none"', 'none')
    words = re.split(r'[\s,]+', answer.strip().lower())
    if 'all' in words:
        return list(SERVICE_CHOICES)
    aliases = {'postgresql': 'postgres', 'pgsql': 'postgres', 'pg': 'postgres', 'mail': 'mailpit'}
    picked = []
    for w in words:
        w = aliases.get(w, w)
        if w in SERVICE_CHOICES and w not in picked:
            picked.append(w)
        elif w and w not in ('none', 'no', 'n'):
            warn(f'unknown service "{w}" (choose from: {", ".join(SERVICE_CHOICES)})')
    return picked


def setup(sites_dir=None, services=None, assume_yes=False):
    print(f'pxm {version()} setup')
    if not shutil.which('pacman'):
        die('pxm needs Arch Linux (Omarchy)')
    if systemctl('show-environment').returncode:
        die('systemd user services are not available')
    if subprocess.run(['systemctl', 'is-active', '--quiet', 'systemd-resolved']).returncode:
        die('pxm needs systemd-resolved (Omarchy uses it by default) for the *.test addresses')

    cfg = load_config()
    chosen = sites_dir or cfg.get('sites_dir') or ''
    if not chosen:
        print('\nEvery folder in your sites folder becomes https://<folder>.test')
        chosen = ask('Sites folder', default_sites_dir().replace(str(HOME), '~'))
    sd = Path(os.path.expanduser(chosen)).resolve()
    picked = choose_services(services) if shutil.which('docker') else []
    if services and not shutil.which('docker'):
        warn('Docker is not installed, so no services were set up (sudo pacman -S docker)')

    missing = [x for x in PACKAGES if subprocess.run(['pacman', '-Q', x], capture_output=True).returncode]
    print('\npxm setup will:')
    if missing:
        print(f"  - install {', '.join(missing)} from the Arch repos")
    print('  - point *.test addresses at this computer, and let the web server use ports 80 and 443')
    print('  - trust a local HTTPS certificate made on this computer')
    print('  - add a marked PATH block to ~/.bashrc and a marked window rule to ~/.config/hypr/hyprland.lua')
    print(f"  - serve every folder in {str(sd).replace(str(HOME), '~')} and download the latest PHP if you have none")
    if picked:
        print(f"  - download and start {', '.join(SERVICE_CHOICES[x] for x in picked)} in Docker")
    print('`pxm uninstall` undoes all of this. The full list is in the README.')
    if not assume_yes and ask('Continue?', 'yes').lower() not in ('y', 'yes'):
        print('Nothing changed.')
        return
    sd.mkdir(parents=True, exist_ok=True)
    cfg['sites_dir'] = str(sd)
    save_config(cfg)

    step('System settings (asks for your password once)' + (' and ' + ', '.join(SERVICE_CHOICES[x] for x in picked)
                                                              if picked else ''))
    run_root('setup', '--services', ','.join(picked))
    report = root_report_path(os.getuid())
    try:
        found = json.loads(report.read_text()).get('containers', [])
        report.unlink()
    except (OSError, ValueError):
        found = []
    if found:
        cfg = load_config()
        cfg['containers'] = sorted(set(cfg.get('containers', [])) | set(found))
        save_config(cfg)

    step('Web server and PHP')
    USER_UNIT_DIR.mkdir(parents=True, exist_ok=True)
    for name, text in user_units(cfg).items():
        (USER_UNIT_DIR / name).write_text(text)
    systemctl('daemon-reload')
    LINK.parent.mkdir(parents=True, exist_ok=True)
    if LINK.is_symlink() or not LINK.exists():
        LINK.unlink(missing_ok=True)
        LINK.symlink_to(SELF)
        ok(f'`pxm` command: {str(LINK).replace(str(HOME), "~")}')
    else:
        warn(f'{LINK} exists and is not pxm; leaving it alone')
    write_shim()
    for rc in SHELL_RCS:
        if rc.exists() or rc.name == '.bashrc':
            # above Omarchy's "interactive shells only" line, so scripts and editors get the right php too
            upsert_block(rc, '#', ['# php = the PHP version pxm picks for the folder you are in; composer global tools',
                                   'export PATH="$HOME/.local/share/pxm/bin:$HOME/.config/composer/vendor/bin:$PATH"'],
                         before='[[ $- != *i* ]] && return')
    ok('`php` follows pxm (in new terminals)')
    for full, d in installed().items():          # keep each version's FPM settings in step with this pxm
        write_version_config(d, full)
    if not installed():
        avail = available(max_age=0)
        latest = max(avail, key=vkey) if avail else None
        if latest:
            try:
                install(latest)
            except SystemExit:
                warn('could not download PHP right now; install one later: pxm php install 8.5')
        else:
            warn('could not reach the PHP download server; install one later: pxm php install 8.5')
    elif not GLOBAL_FILE.exists():
        use(minor(list(installed())[-1]))
    apply(quiet=True)
    import time
    for _ in range(40):
        if systemctl('is-active', 'pxm-caddy.service').stdout.strip() == 'active':
            break
        time.sleep(0.25)
    if systemctl('is-active', 'pxm-caddy.service').stdout.strip() == 'active':
        ok('web server running')
    else:
        warn('the web server did not start: journalctl --user -u pxm-caddy')
    if trust_nss():
        ok('HTTPS certificate trusted in Chromium-based browsers')

    step('Composer and the Laravel installer')
    if shutil.which('laravel') or (HOME / '.config/composer/vendor/bin/laravel').exists():
        ok('already installed')
    elif shutil.which('composer'):
        env = dict(os.environ, PATH=f'{SHIMS}:{os.environ.get("PATH", "")}')
        r = subprocess.run(['composer', 'global', 'require', '--quiet', 'laravel/installer'], env=env)
        ok('installed `laravel`') if r.returncode == 0 else warn('could not install it: composer global require laravel/installer')

    step('Omarchy')
    if HYPR_CONF.exists():
        upsert_block(HYPR_CONF, '--', [
            '-- the pxm window floats like an app window, fully opaque',
            'o.window({ class = "^org.quickshell$", title = "^pxm$" }, { float = true, center = true, '
            'size = { 1000, 680 }, tag = "-default-opacity", opacity = "1.0 1.0" })'])
        subprocess.run(['hyprctl', 'reload'], capture_output=True)
        ok('window rule added to ~/.config/hypr/hyprland.lua')
    enabled = omarchy_plugin_enabled()
    plugins = HOME / '.config/omarchy/plugins'
    installed_as_plugin = plugins.is_dir() and any(d.resolve() == PLUGIN_DIR for d in plugins.iterdir())
    if enabled is False and installed_as_plugin:
        r = subprocess.run(['omarchy', 'plugin', 'enable', PLUGIN_ID], capture_output=True, text=True)
        ok('bar icon enabled') if r.returncode == 0 else warn('enable the bar icon with: omarchy plugin enable pxm')
    elif enabled:
        ok('bar icon enabled')

    step('Check')
    problems = [c for c in doctor_checks() if not c[1]]
    for label, _, fix in problems:
        warn(f'{label}: {fix}')
    if not problems:
        ok('everything is in place')
    g = global_version()
    print(f"""
pxm is ready.
  Sites folder:  {str(sd).replace(str(HOME), '~')}  (every folder in it is https://<folder>.test)
  Global PHP:    {full_version(g) or g}
  Open a new terminal so `php` uses pxm, then click the snake in the bar or run: pxm ui""")


def doctor_checks():
    """[(what, ok, how to fix)]"""
    cfg = load_config()
    fix_setup = 'run pxm setup'
    out = []
    missing = [p for p in PACKAGES if subprocess.run(['pacman', '-Q', p], capture_output=True).returncode]
    out.append(('packages', not missing, f"missing {', '.join(missing)}: {fix_setup}"))
    out.append(('sites folder', bool(cfg.get('sites_dir')) and Path(cfg.get('sites_dir') or '/nonexistent').is_dir(), fix_setup))
    dns = subprocess.run(['getent', 'hosts', 'pxm-check.test'], capture_output=True, text=True).stdout
    out.append(('*.test addresses', '127.0.0.1' in dns or '::1' in dns, 'sudo systemctl restart pxm-dns pxm-dns-route'))
    port = cmd_out(['sysctl', '-n', 'net.ipv4.ip_unprivileged_port_start'])
    out.append(('ports 80/443', port.isdigit() and int(port) <= 80, fix_setup))
    out.append(('web server', cfg.get('web_stopped') or systemctl('is-active', 'pxm-caddy.service').stdout.strip() == 'active',
                'pxm service start web'))
    out.append(('HTTPS certificate', CA_ROOT.exists() and Path(CA_ANCHOR).exists(), 'pxm trust'))
    out.append(('`pxm` command', LINK.is_symlink() and LINK.resolve() == SELF, fix_setup))
    out.append(('`php` follows pxm', any(BLOCK_BEGIN in rc.read_text() for rc in SHELL_RCS if rc.exists()), fix_setup))
    has_php = global_version() == 'system' and has_system_php() or (PHPS / global_version()).exists()
    out.append(('a global PHP', has_php, 'pxm php install 8.5'))
    if shutil.which('omarchy'):
        out.append(('bar icon', omarchy_plugin_enabled() is not False, 'omarchy plugin enable pxm'))
    return out


def doctor():
    if not is_ready():
        die('pxm is not set up yet. Run: pxm setup')
    bad = 0
    for label, good, fix in doctor_checks():
        print(f"  {'✓' if good else '✗'} {label}" + ('' if good else f'  →  {fix}'))
        bad += not good
    if bad:
        sys.exit(1)


def uninstall(purge=False, assume_yes=False):
    cfg = load_config()
    print('This removes what pxm setup changed: the *.test addresses, the web server, the HTTPS certificate,')
    print('the port setting, the shell PATH line and the window rule. Your sites and Docker databases are kept.')
    if purge:
        print('--purge: your PHP versions and pxm settings are deleted too.')
    if not assume_yes and ask('Continue?', 'no').lower() not in ('y', 'yes'):
        print('Nothing changed.')
        return

    step('Sharing and web server')
    for name in cfg.get('shared', []):
        systemctl('stop', share_unit(name))
    systemctl('stop', TUNNEL_UNIT)
    running = re.findall(r'^(pxm-fpm@\S+\.service)', systemctl('list-units', '--plain', '--no-legend', '--all',
                                                                 'pxm-fpm@*').stdout, re.M)
    systemctl('disable', '--now', 'pxm-sites.path', 'pxm-caddy.service', *running)
    for name in USER_UNITS:
        (USER_UNIT_DIR / name).unlink(missing_ok=True)
    systemctl('daemon-reload')
    systemctl('reset-failed')
    ok('stopped and removed')

    step('System settings (asks for your password once)')
    run_root('uninstall')

    step('Your account')
    if shutil.which('certutil'):
        subprocess.run(['certutil', '-D', '-d', f'sql:{NSSDB}', '-n', CA_NAME], capture_output=True)
    for rc in SHELL_RCS:
        remove_block(rc, '#')
    if remove_block(HYPR_CONF, '--'):
        subprocess.run(['hyprctl', 'reload'], capture_output=True)
    if LINK.is_symlink() and LINK.resolve() == SELF:
        LINK.unlink()
    if purge:
        for d in (DATA, CONF_DIR, CACHE):
            shutil.rmtree(d, ignore_errors=True)
        ok('PHP versions and settings deleted')
    else:
        cfg = load_config()
        cfg['shared'] = []
        cfg.pop('share_mode', None)
        save_config(cfg)
        ok('PHP versions and settings kept in ~/.local/share/pxm and ~/.config/pxm (pxm setup picks them up again)')
    ok('PATH line, window rule and certificate removed')
    tunnel = (cfg.get('tunnel') or {}).get('name')
    print(f"""
pxm is uninstalled.
  - The bar icon and window are an Omarchy plugin: omarchy plugin remove pxm
  - Packages were kept (other apps may use them): {' '.join(PACKAGES)}
  - Docker containers (your databases) were kept: mysql8, postgres18, redis, mailpit""" + (f"""
  - Your Cloudflare tunnel {tunnel} still exists: cloudflared tunnel delete {tunnel}""" if tunnel else ''))


# ------------------------------------------------------------------ status
def status():
    cfg = load_config()
    if not is_ready(cfg):
        return {'ready': False, 'version': version(), 'pxm': str(SELF), 'sites': {}, 'services': [], 'installed': []}
    g = global_version()
    site_map = sites(cfg)
    share_status(site_map)
    return {
        'ready': True,
        'version': version(),
        'global': g,
        'global_full': full_version(g),
        'installed': [{'version': v, 'minor': minor(v), 'kind': build_kind(v),
                       'active': (PHPS / minor(v)).is_symlink() and os.readlink(PHPS / minor(v)) == v}
                      for v in installed()],
        'system': full_version('system') if has_system_php() else '',
        'sites_dir': cfg['sites_dir'],
        'sites': site_map,
        'node': node_status(site_map),
        'share_domain': cfg.get('share_domain') or '',
        'caddy': systemctl('is-active', 'pxm-caddy.service').stdout.strip(),
        'available': [{'minor': m, 'version': v, 'installed': v in installed()} for m, v in available().items()],
        'prereleases': prereleases(),
        'buildable': BUILDABLE_MINORS,
        'building': building(),
        'installing': sorted(p.name.removeprefix('installing-') for p in CACHE.glob('installing-*')) if CACHE.exists() else [],
        'services': services_status(cfg),
        'docker': shutil.which('docker') is not None,
        'trusted': (NSSDB / 'cert9.db').exists() and subprocess.run(
            ['certutil', '-L', '-d', f'sql:{NSSDB}', '-n', CA_NAME], capture_output=True).returncode == 0,
    }


# ------------------------------------------------------------------ main
def main(argv):
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(__doc__)
        return
    cmd, rest = argv[0], argv[1:]
    if cmd in ('-v', '--version', 'version'):
        print(f'pxm {version()}')
        return
    if cmd == '_root':
        return root_main(rest[0] if rest else '', rest[1:])
    if cmd == 'setup':
        def opt(name):
            return next((rest[i + 1] for i, a in enumerate(rest) if a == name and i + 1 < len(rest)), None)
        return setup(opt('--sites-dir'), opt('--services'), assume_yes='--yes' in rest or '-y' in rest)
    if cmd == 'doctor':
        return doctor()
    if cmd == 'uninstall':
        return uninstall(purge='--purge' in rest, assume_yes='--yes' in rest or '-y' in rest)
    if cmd == 'status':
        print(json.dumps(status(), indent=None if '--json' in rest else 2))
        return
    if not is_ready():
        die('pxm is not set up yet. Run: pxm setup')
    if cmd == 'php':
        sub = rest[0] if rest else 'list'
        arg = rest[1] if len(rest) > 1 else None
        if sub == 'list':
            g = global_version()
            if Path(SYSTEM_PHP).exists():
                print(f"  system   {full_version('system'):10} (Arch package)" + ('   * global' if g == 'system' else ''))
            for v in installed():
                m = minor(v)
                current = (PHPS / m).is_symlink() and os.readlink(PHPS / m) == v
                kind = 'full build' if build_kind(v) == 'full' else 'quick'
                print(f"  {m:8} {v:12} {kind:10}" + ('  * global' if g == m and current else ('' if current else '  (older, not in use)')))
        elif sub == 'available':
            have = set(installed())
            for m, v in available().items():
                print(f"  {m:6} {v:10}" + ('  installed' if v in have else ''))
        elif sub == 'install' and arg:
            install(arg)
        elif sub == 'build' and arg:
            build(arg, foreground='--foreground' in rest)
        elif sub in ('prereleases', 'pre'):
            for p in prereleases(max_age=0):
                print(f"  {p['version']:14} {p['date']}")
        elif sub == 'use' and arg:
            use(arg)
        elif sub == 'isolate' and arg:
            isolate(arg, rest[2] if len(rest) > 2 else None)
        elif sub == 'unisolate':
            unisolate(arg)
        elif sub == 'uninstall' and arg:
            uninstall(arg)
        elif sub == 'info':
            data = php_info()
            if '--json' in rest:
                print(json.dumps(data))
            else:
                for v in data:
                    print(f"  {v['label']:14} {v['version']:12} {v['kind']:8} {len(v['extensions'])} extensions  ini: {v['ini']}")
        elif sub == 'which':
            v, root = project_version()
            name = v or global_version()
            src = f'pinned by {root}/.php-version' if v else 'global'
            print(f'{php_binary(name)}  (PHP {full_version(name)}, {src})')
        else:
            die('unknown php command; see pxm --help')
    elif cmd == 'sites':
        all_sites = sites()
        if not all_sites:
            print(f"No sites yet. Put a project in {load_config()['sites_dir']} or run `pxm link` in a project folder.")
        for n, s in all_sites.items():
            flags = ('🔒 ' if s['secure'] else '   ') + ('linked' if s['source'] == 'linked' else 'parked')
            print(f"  {s['url']:<32} PHP {s['php']:<7} {flags:<10} {s['path']}")
    elif cmd == 'link':
        link(rest[0] if rest else None)
    elif cmd == 'unlink' and rest:
        unlink(rest[0])
    elif cmd in ('secure', 'unsecure'):
        set_secure(rest[0] if rest else None, cmd == 'secure')
    elif cmd == 'open':
        if rest and re.match(r'^[a-z]+://', rest[0]):
            open_url(rest[0])
        else:
            _, s = find_site(rest[0] if rest else None)
            open_url(s['url'])
    elif cmd == 'share' and rest[:1] == ['domain']:
        if len(rest) < 2:
            d = load_config().get('share_domain')
            print(f'Shared sites get https://<site>.{d}' if d else 'No domain connected: shared sites get random *.trycloudflare.com links')
        elif rest[1] == 'off':
            share_domain_off()
        else:
            share_domain_setup(rest[1])
    elif cmd == 'share':
        args = [a for a in rest if not a.startswith('--')]
        share(args[0] if args else None, quick='--quick' in rest)
    elif cmd == 'unshare':
        unshare(rest[0] if rest else None)
    elif cmd == 'shares':
        site_map = sites()
        share_status(site_map)
        on = {n: s['share'] for n, s in site_map.items() if s['share']['on']}
        if not on:
            print('Nothing is shared right now.')
        for n, sh in on.items():
            print(f"  {n}.test  →  {sh['url'] or '(starting…)'}")
            for w in sh['warnings']:
                print('     ! ' + w)
    elif cmd == 'edit':
        open_editor(rest[0] if rest else None)
    elif cmd in ('term', 'terminal'):
        path = rest[0] if rest and rest[0] != '--' else None
        command = rest[rest.index('--') + 1:] if '--' in rest else None
        open_terminal(path, command)
    elif cmd == 'files':
        open_files(rest[0] if rest else None)
    elif cmd == 'prefs':
        if rest[:1] == ['set'] and len(rest) >= 3:
            set_pref(rest[1], rest[2], rest[3] if len(rest) > 3 else None)
        elif '--json' in rest:
            print(json.dumps(prefs()))
        else:
            for kind, p in prefs().items():
                names = {o['value']: o['label'] for o in p['options']}
                cur = names.get(p['value'], p['value']) + (f"  →  {p['custom']}" if p['value'] == 'custom' else '')
                others = ', '.join(o['value'] for o in p['options'][1:-1]) or 'none'
                print(f"  {kind:9} {cur}\n            installed: {others}")
    elif cmd == 'apply':
        apply(quiet='--quiet' in rest)
    elif cmd == 'trust':
        trust()
    elif cmd == 'service':
        sub = rest[0] if rest else 'list'
        if sub == 'list':
            for i, n, port, url, _ in SERVICES:
                print(f"  {i:9} {n:20} {'running' if port_open(port) else 'stopped':8} :{port}")
        elif sub in ('start', 'stop') and len(rest) > 1:
            service(sub, rest[1])
        else:
            die('usage: pxm service list | start <name> | stop <name>')
    elif cmd == 'node':
        sub = rest[0] if rest else 'list'
        arg = rest[1] if len(rest) > 1 else None
        if sub == 'list':
            g = node_resolve(node_global_spec())
            inst = node_installed()
            if not inst:
                print('  no Node versions yet: pxm node install lts')
            for v in inst:
                print(f'  {v:12}' + ('  * global' if v == g else ''))
        elif sub == 'available':
            for l in node_lines():
                print(f"  {l['major']:4} {l['version']:12} {('LTS ' + l['lts']) if l['lts'] else 'current'}")
        elif sub == 'install' and arg:
            node_install(arg)
        elif sub == 'use' and arg:
            node_use(arg)
        elif sub == 'isolate' and arg:
            node_isolate(arg, rest[2] if len(rest) > 2 else None)
        elif sub == 'unisolate':
            node_unisolate(arg)
        elif sub == 'uninstall' and arg:
            node_uninstall(arg)
        elif sub == 'which':
            spec, f = node_project_spec(arg or os.getcwd(), node_nvmrc_enabled())
            v = node_resolve(spec) if spec else node_resolve(node_global_spec())
            print(f"Node {v or (spec + ' (not installed: pxm node install ' + spec + ')')}" + (f'  (from {f})' if f else '  (global)'))
        elif sub == 'nvmrc' and arg in ('on', 'off'):
            node_nvmrc(arg == 'on')
        else:
            die('usage: pxm node list|available|install|use|isolate|unisolate|uninstall|which|nvmrc')
    elif cmd == 'ui':
        ui(rest[0] if rest else 'sites')
    elif cmd == 'logs':
        data = logs(rest[0] if rest and not rest[0].startswith('-') else None)
        if '--json' in rest:
            print(json.dumps(data))
        else:
            for f in data['files']:
                print(f"== {f['label']} ({f['path']})\n{f['text']}\n")
    elif cmd == 'mail' and rest[:1] == ['test']:
        mail_test(rest[1] if len(rest) > 1 else 'you@example.test')
    else:
        die(f'unknown command {cmd!r}; see pxm --help')


if __name__ == '__main__':
    main(sys.argv[1:])
