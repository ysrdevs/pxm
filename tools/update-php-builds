#!/usr/bin/python3
"""Refresh php-builds.json: the prebuilt PHP versions pxm may download, with their SHA-256 checksums.

dl.static-php.dev publishes no checksums, so pxm only installs versions listed here and checks
each download against the recorded digest. Run this after a PHP release, then commit the result.

    tools/update-php-builds            # add the newest patch of every minor line
    tools/update-php-builds 8.4.22     # add specific versions
"""
import hashlib
import json
import re
import sys
import urllib.request
from datetime import date
from pathlib import Path

BUILDS = 'https://dl.static-php.dev/static-php-cli/common/'
UA = {'User-Agent': 'pxm (https://github.com/ysrdevs/pxm)'}
MANIFEST = Path(__file__).resolve().parent.parent / 'php-builds.json'


def fetch(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=300) as r:
        return r.read()


def sha256(url):
    h = hashlib.sha256()
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=600) as r:
        for chunk in iter(lambda: r.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def newest_per_minor():
    found = {}
    for e in json.loads(fetch(BUILDS + '?format=json')):
        m = re.fullmatch(r'php-(\d+\.\d+\.\d+)-fpm-linux-x86_64\.tar\.gz', e['name'])
        if m:
            v = m.group(1)
            key = tuple(map(int, v.split('.')))
            if key[:2] not in found or key > found[key[:2]]:
                found[key[:2]] = key
    return ['.'.join(map(str, k)) for k in sorted(found.values()) if k >= (8, 1)]


def main():
    manifest = json.loads(MANIFEST.read_text()) if MANIFEST.exists() else {'source': BUILDS, 'versions': {}}
    wanted = sys.argv[1:] or newest_per_minor()
    for v in wanted:
        if v in manifest['versions']:
            print(f'{v}: already listed')
            continue
        entry = {}
        for kind in ('cli', 'fpm'):
            url = f'{BUILDS}php-{v}-{kind}-linux-x86_64.tar.gz'
            print(f'{v} {kind}: downloading…', flush=True)
            entry[kind] = sha256(url)
        manifest['versions'][v] = entry
        print(f'{v}: cli {entry["cli"][:12]}…  fpm {entry["fpm"][:12]}…')
    manifest['source'] = BUILDS
    manifest['updated'] = date.today().isoformat()
    manifest['versions'] = dict(sorted(manifest['versions'].items(), key=lambda kv: tuple(map(int, kv[0].split('.')))))
    MANIFEST.write_text(json.dumps(manifest, indent=1) + '\n')
    print(f'wrote {MANIFEST} ({len(manifest["versions"])} versions)')


if __name__ == '__main__':
    main()
